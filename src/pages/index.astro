---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getHomeConfig, getInfraConfig } from '../utils/config';
import { fetchCredlyBadges } from '../utils/credly';
import {
  ArrowDownRight, ArrowUpRight, BookOpen, Box, Braces, Cloud,
  ExternalLink, Github, Network, Server, ShieldCheck, Sparkles,
} from '@lucide/astro';

const portfolio = getHomeConfig();
const infra = getInfraConfig() as any;
const profile = portfolio.profile || {};
const sections = portfolio.sections || {};

let credlyBadges: any[] = [];
if (portfolio.credly?.enabled && portfolio.credly?.username) {
  try {
    credlyBadges = await fetchCredlyBadges(portfolio.credly.username, portfolio.credly.pinnedIds ?? []);
  } catch (error) {
    console.warn('[Credly] Failed:', error);
  }
}

const certifications = (credlyBadges.length > 0
  ? credlyBadges.map((badge: any) => ({
      id: badge.id, title: badge.title, issuer: badge.issuer, date: badge.date,
      credly_url: badge.credlyUrl, badge_image: badge.imageUrl, pinned: badge.pinned ?? false,
    }))
  : (portfolio.certifications || [])).slice(0, 9);

const projectPriority: Record<string, number> = { murmurOS: 0, alyx: 1, 'infra & docu': 2, trainCerts: 3 };
const projects = [...(portfolio.projects || [])].sort(
  (a: any, b: any) => (projectPriority[a.id] ?? 99) - (projectPriority[b.id] ?? 99),
);
const heroLinks = (portfolio.heroLinks || []).filter((link: any) => link.enabled !== false);
const iconMap: Record<string, any> = { Library: BookOpen, Server, FileText: Braces, Code: Braces, Globe: Cloud };
const documentedWorkloads = (infra.serviceGroups || []).reduce(
  (total: number, group: any) => total + (group.services || []).length,
  0,
);
const exposedServices = (infra.wanExposure?.exposedServices || []).length;

const labNodes = [
  { id: 'edge', label: 'Edge', eyebrow: 'WAN / frontière', title: 'Edge & sécurité', text: 'Filtrage, terminaison TLS et contrôle des flux avant exposition des services.', tech: 'OPNsense · BunkerWeb · CrowdSec', icon: ShieldCheck },
  { id: 'compute', label: 'Compute', eyebrow: 'Cluster / calcul', title: 'Nœuds Proxmox', text: `${infra.proxmoxNodes?.length || 3} nœuds orchestrent les charges virtuelles, les conteneurs et le stockage distribué.`, tech: `${infra.stats?.totalCpuCores || 32} cœurs · ${infra.stats?.totalRamGB || 80} Go RAM · Ceph`, icon: Server },
  { id: 'platform', label: 'Platform', eyebrow: 'Services / plateforme', title: 'Services souverains', text: 'Applications, identité, observabilité et workloads Kubernetes exploités en autonomie.', tech: `${infra.stats?.totalServices || 18}+ services · Kubernetes · OIDC`, icon: Box },
  { id: 'data', label: 'Data', eyebrow: 'Stockage / résilience', title: 'Données & sauvegardes', text: 'Stockage distribué et NAS isolé pour concilier disponibilité, capacité et reprise.', tech: `Ceph ${infra.stats?.cephStorage || '3×2 To'} · NAS ${infra.stats?.nasStorage || '2×12 To'}`, icon: Network },
];

const networkTechnician = certifications.find((cert: any) =>
  /network technician/i.test(cert.title || ''),
);
const highlightedCerts = [
  ...certifications.slice(0, 3),
  ...(networkTechnician && !certifications.slice(0, 3).some((cert: any) => cert.id === networkTechnician.id)
    ? [networkTechnician]
    : []),
];
const highlightedIds = new Set(highlightedCerts.map((cert: any) => cert.id));
const otherCerts = certifications.filter((cert: any) => !highlightedIds.has(cert.id));
---

<BaseLayout title="Home" description={profile.tagline}>
  <div class="portfolio-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-kicker"><span aria-hidden="true">$</span> whoami</p>
        <h1 id="hero-title"><span class="title-prefix">.</span>{profile.pseudo}</h1>
        <p class="hero-role">sysadmin | infra &amp; cloud; open source | privacy | sovereignty</p>
        <p class="hero-statement">Je construis des infrastructures <strong>ouvertes</strong>, <strong>souveraines</strong> et <strong>automatisées</strong>.</p>

        <div class="hero-console" aria-label="Technologies pratiquées">
          <span class="console-prompt" aria-hidden="true">adenyrr@workstation:~$</span>
          <span id="hero-command">terraform plan</span>
          <span class="console-cursor" aria-hidden="true"></span>
        </div>

        <div class="hero-actions">
          <a class="action action-primary" href="#projects">Explorer mes projets <ArrowDownRight size={17} /></a>
          <a class="action action-secondary" href="/infra">Ouvrir ~/lab <ArrowUpRight size={16} /></a>
        </div>
      </div>

      <aside class="system-card glass-surface" aria-label="Résumé système d’adenyrr">
        <header class="tui-titlebar">
          <span class="tui-title"><b aria-hidden="true">╭─</b> system.profile <b aria-hidden="true">─╮</b></span>
          <span class="tui-view">tty / 01</span>
          <span class="tui-online"><i aria-hidden="true"></i> ready</span>
        </header>

        <p class="tui-command"><span class="tui-prompt">adenyrr@home:~$</span> fastfetch <span class="tui-flag">--config sovereign.toml</span><i aria-hidden="true"></i></p>

        <div class="fetch-body">
          <div class="fetch-orbit" aria-hidden="true">
            <span class="orbit-axis orbit-axis-x"></span>
            <span class="orbit-axis orbit-axis-y"></span>
            <span class="orbit-ring orbit-ring-outer"><i></i></span>
            <span class="orbit-ring orbit-ring-inner"><i></i></span>
            <span class="orbit-core"><b>A</b><small>SYS</small></span>
          </div>

          <div class="fetch-heading">
            <span class="fetch-mark" aria-hidden="true">A<span>:</span></span>
            <div><strong>adenyrr<span>@home</span></strong><small>sovereign systems operator</small></div>
          </div>

          <dl class="fetch-list">
            <div><dt><span>01</span>identity</dt><dd><strong>adenyrr</strong> / operator</dd></div>
            <div><dt><span>02</span>host</dt><dd>adenyrr.me</dd></div>
            <div><dt><span>03</span>role</dt><dd>sysadmin · Charleroi, BE</dd></div>
            <div><dt><span>04</span>cluster</dt><dd>{infra.proxmoxNodes?.length || 3}× Proxmox VE · 1× ARM edge</dd></div>
            <div><dt><span>05</span>compute</dt><dd>{infra.stats?.totalCpuCores || 32} cores · x86_64</dd></div>
            <div><dt><span>06</span>memory</dt><dd>{infra.stats?.totalRamGB || 80} GiB · DDR4</dd></div>
            <div><dt><span>07</span>storage</dt><dd>{infra.stats?.cephStorage || '3×2 To'} Ceph · {infra.stats?.nasStorage || '2×12 To'} NAS</dd></div>
            <div><dt><span>08</span>network</dt><dd>{infra.vlans?.length || 11} VLAN · OPNsense · WireGuard</dd></div>
            <div><dt><span>09</span>services</dt><dd>{documentedWorkloads} workloads · <em>{exposedServices} exposed</em></dd></div>
            <div><dt><span>10</span>security</dt><dd>CrowdSec · BunkerWeb · step-ca</dd></div>
            <div><dt><span>11</span>platform</dt><dd>Traefik · Authentik · Kubernetes</dd></div>
            <div><dt><span>12</span>systems</dt><dd>openSUSE · Debian</dd></div>
          </dl>
        </div>

        <footer class="tui-footer">
          <span class="fetch-palette" aria-label="Palette du site"><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <span class="fetch-state"><i aria-hidden="true"></i> available</span>
          <span class="tui-clock"><span id="local-time">--:--:--</span> · up <span id="page-uptime">00:00</span></span>
        </footer>
      </aside>
    </section>

    <section class="about-strip" aria-label="Présentation">
      <div class="section-index">01</div>
      <p class="about-command"><span>~/about.md</span> <span aria-hidden="true">—</span> {profile.title}</p>
      <div class="about-body">
        <p>{profile.bio}</p>
        <div class="about-links">
          {heroLinks.map((link: any) => {
            const Icon = iconMap[link.icon];
            const isExternal = link.internal === false;
            return (
              <a href={link.url} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
                {Icon && <Icon size={15} />} {link.label}{isExternal && <ExternalLink size={12} />}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {sections.projects && (
      <section class="work-section" id="projects" aria-labelledby="projects-title">
        <header class="editorial-heading">
          <div><p class="path-label"><span>02</span> ~/work</p><h2 id="projects-title">Selected work</h2></div>
          <p>Des systèmes conçus pour être compris, automatisés et réellement opérables.</p>
        </header>

        <div class="projects-bento">
          {projects.map((project: any, index: number) => {
            const Icon = iconMap[project.icon] || Server;
            return (
              <article class:list={['project-panel', `project-${index + 1}`, { 'project-primary': index === 0 }]} data-spotlight>
                {project.image && <img class="project-art" src={project.image} alt="" loading="lazy" decoding="async" />}
                <div class="project-scrim" aria-hidden="true"></div>
                <div class="project-topline"><span class="project-number">0{index + 1}</span><span class="project-year">{project.year}</span></div>
                <div class="project-content">
                  <span class="project-icon" aria-hidden="true"><Icon size={18} /></span>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <ul class="tech-list" aria-label="Technologies">{(project.tech || []).map((tech: string) => <li>{tech}</li>)}</ul>
                  <div class="project-actions">
                    {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer">Découvrir <ArrowUpRight size={15} /></a>}
                    {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`Code source de ${project.title}`}><Github size={16} /> Code</a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="lab-section" aria-labelledby="lab-title">
      <header class="editorial-heading">
        <div><p class="path-label"><span>03</span> ~/lab</p><h2 id="lab-title">Infrastructure, en direct du plan.</h2></div>
        <p>Explorez les couches d’un homelab qui sert autant de plateforme que de terrain d’expérimentation.</p>
      </header>

      <div class="lab-console glass-surface">
        <div class="lab-toolbar"><span><i aria-hidden="true"></i> topology.map</span><span>{infra.stats?.totalServices || 18} services <b aria-hidden="true">·</b> documentés</span></div>
        <div class="lab-workspace">
          <div class="topology" role="group" aria-label="Couches de l’infrastructure">
            <span class="topology-source">Internet</span><span class="topology-line" aria-hidden="true"></span>
            {labNodes.map((node, index) => {
              const Icon = node.icon;
              return (
                <button class:list={['topology-node', { active: index === 0 }]} type="button" data-lab-node={node.id}
                  data-eyebrow={node.eyebrow} data-title={node.title} data-text={node.text} data-tech={node.tech}
                  aria-pressed={index === 0 ? 'true' : 'false'}>
                  <span class="node-icon"><Icon size={19} /></span><span>{node.label}</span><small>0{index + 1}</small>
                </button>
              );
            })}
          </div>

          <aside class="node-inspector" aria-live="polite">
            <p id="node-eyebrow">{labNodes[0].eyebrow}</p><h3 id="node-title">{labNodes[0].title}</h3>
            <p id="node-text">{labNodes[0].text}</p><code id="node-tech">{labNodes[0].tech}</code>
            <a href="/infra">Explorer toute l’infrastructure <ArrowUpRight size={15} /></a>
          </aside>
        </div>
      </div>
    </section>

    <section class="journey-section" aria-labelledby="journey-title">
      <header class="editorial-heading">
        <div><p class="path-label"><span>04</span> ~/journey</p><h2 id="journey-title">Parcours & credentials</h2></div>
        <p>Un parcours non linéaire, guidé par le concret, la curiosité et l’apprentissage continu.</p>
      </header>

      <div class="journey-grid">
        <div class="timeline-panel glass-surface">
          <p class="panel-label">journalctl --career</p>
          <ol class="career-timeline">
            {(portfolio.jobs || []).map((job: any) => <li><time>{job.period}</time><div><span>Expérience</span><h3>{job.title}</h3><p>{job.company} · {job.location}</p></div></li>)}
            {(portfolio.diplomas || []).slice().reverse().map((diploma: any) => <li><time>{diploma.period}</time><div><span>Formation</span><h3>{diploma.title}</h3><p>{diploma.institution}</p></div></li>)}
          </ol>
        </div>

        {sections.certifications && certifications.length > 0 && (
          <div class="credentials-panel glass-surface">
            <div class="credential-heading"><div><p class="panel-label">ls ~/credentials</p><h3>Certifications récentes</h3></div><ShieldCheck size={22} aria-hidden="true" /></div>
            <div class="credential-list">
              {highlightedCerts.map((cert: any) => (
                <a href={cert.credly_url} target="_blank" rel="noopener noreferrer" class="credential">
                  <Image src={cert.badge_image} alt="" inferSize width={96} height={96} format="webp" loading="lazy" decoding="async" />
                  <span><strong>{cert.title}</strong><small>{cert.issuer} · {cert.date}</small></span><ArrowUpRight size={15} aria-hidden="true" />
                </a>
              ))}
            </div>
            {otherCerts.length > 0 && (
              <details class="other-credentials">
                <summary><span>+ {otherCerts.length} autres credentials</span><span class="details-plus" aria-hidden="true">+</span></summary>
                <ul>{otherCerts.map((cert: any) => <li><a href={cert.credly_url} target="_blank" rel="noopener noreferrer">{cert.title}<ArrowUpRight size={13} /></a></li>)}</ul>
              </details>
            )}
          </div>
        )}
      </div>
    </section>

    <section class="contact-panel" aria-labelledby="contact-title">
      <div><p class="path-label"><span>05</span> ~/contact</p><h2 id="contact-title">Construisons quelque chose de robuste.</h2></div>
      <p>Une idée, une infrastructure à fiabiliser ou simplement envie de parler Linux et open source&nbsp;?</p>
      <a class="action action-primary" href="mailto:adenyrr@proton.me">Démarrer une conversation <Sparkles size={16} /></a>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-shell { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 3.5rem 0 5rem; }
  .glass-surface { background: color-mix(in srgb, var(--glass-bg-strong) 86%, transparent); border: 1px solid var(--glass-border); box-shadow: var(--shadow), inset 0 1px var(--glint); backdrop-filter: blur(var(--glass-blur)) saturate(135%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(135%); }
  .hero { min-height: calc(100svh - 7rem); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(430px, .95fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding: clamp(3rem, 8vh, 6.5rem) 0; }
  .hero-kicker, .path-label, .panel-label { margin: 0; color: var(--text-muted); font: 600 .76rem/1.4 var(--font-code); letter-spacing: .12em; text-transform: uppercase; }
  .hero-kicker span { color: var(--accent-teal); margin-right: .55rem; }
  .hero h1 { margin: .3rem 0 .8rem; font-size: clamp(4rem, 10vw, 8.8rem); font-weight: 740; letter-spacing: -.085em; line-height: .9; }
  .title-prefix { color: var(--accent-amber); }
  .hero-role { margin: 0 0 1.65rem; color: var(--accent-blue); font: 600 clamp(.78rem, 1.4vw, .98rem)/1.5 var(--font-code); letter-spacing: .04em; }
  .hero-role span { color: var(--text-muted); margin: 0 .2rem; }
  .hero-statement { max-width: 670px; margin: 0; color: var(--text-secondary); font-size: clamp(1.28rem, 2.35vw, 2rem); line-height: 1.42; letter-spacing: -.025em; text-wrap: balance; }
  .hero-statement strong { color: var(--text-primary); font-weight: 650; }
  .hero-console { display: flex; align-items: center; width: min(100%, 570px); min-height: 44px; margin: 2.1rem 0 0; padding: .65rem .9rem; overflow: hidden; color: var(--text-primary); background: color-mix(in srgb, var(--bg-1) 88%, transparent); border: 1px solid var(--glass-border); border-radius: 9px; font: .8rem/1.5 var(--font-code); box-shadow: inset 0 1px var(--glint); }
  .console-prompt { color: var(--accent-teal); margin-right: .65rem; white-space: nowrap; }
  #hero-command { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .console-cursor { width: .55em; height: 1.15em; margin-left: .22rem; background: var(--accent-amber); animation: cursor-blink 1.05s steps(1) infinite; }
  @keyframes cursor-blink { 50% { opacity: 0; } }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.55rem; }
  .action { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 46px; padding: .72rem 1rem; border: 1px solid var(--glass-border); border-radius: 9px; font: 650 .82rem/1 var(--font-code); text-decoration: none; transition: transform .2s ease, background-color .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .action-primary { color: var(--bg-0); background: var(--accent-amber); border-color: var(--accent-amber); }
  .action-primary:hover { color: var(--bg-0); transform: translateY(-2px); box-shadow: 0 10px 30px rgba(var(--amber-rgb), .22); }
  .action-secondary { color: var(--text-primary); background: var(--glass-bg); }
  .action-secondary:hover { color: var(--accent-blue); border-color: rgba(var(--blue-rgb), .55); transform: translateY(-2px); }
  .system-card {
    position: relative;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border-radius: 14px;
    font-family: var(--font-code);
  }
  .system-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(var(--blue-rgb), .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--blue-rgb), .035) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .tui-titlebar {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 39px;
    padding: 0 .8rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--bg-1) 72%, transparent);
    font-size: .61rem;
  }
  .tui-title { color: var(--text-secondary); white-space: nowrap; }
  .tui-title b { color: var(--accent-blue); font-weight: 500; }
  .tui-view { text-transform: uppercase; letter-spacing: .1em; }
  .tui-online { display: inline-flex; align-items: center; justify-self: end; gap: .35rem; color: var(--accent-teal); text-transform: uppercase; letter-spacing: .08em; }
  .tui-online i { width: 6px; height: 6px; border-radius: 1px; background: currentColor; box-shadow: 0 0 9px rgba(var(--teal-rgb), .75); }
  .tui-command { position: relative; z-index: 2; display: flex; align-items: center; gap: .45rem; margin: 0; padding: .72rem .9rem; overflow: hidden; color: var(--text-secondary); border-bottom: 1px dashed var(--glass-border); font-size: .64rem; white-space: nowrap; }
  .tui-command .tui-prompt { color: var(--accent-teal); font-weight: 650; }
  .tui-command .tui-flag { overflow: hidden; color: var(--text-muted); font-weight: 400; text-overflow: ellipsis; }
  .tui-command > i { flex: 0 0 auto; width: .5em; height: 1.05em; margin-left: -.22rem; background: var(--accent-amber); animation: cursor-blink 1.05s steps(1) infinite; }

  .fetch-body { position: relative; z-index: 1; padding: 1rem 1rem 1.15rem; }
  .fetch-heading { position: relative; z-index: 2; display: flex; align-items: center; gap: .75rem; min-height: 54px; margin-bottom: .85rem; }
  .fetch-mark { display: grid; place-items: center; width: 45px; height: 45px; color: var(--bg-0); border-radius: 8px 2px 8px 2px; background: var(--accent-amber); font: 800 1.35rem/1 var(--font-sans); transform: rotate(-3deg); box-shadow: 6px 6px 0 rgba(var(--blue-rgb), .15); }
  .fetch-mark span { color: var(--bg-0); opacity: .5; }
  .fetch-heading > div { display: grid; gap: .2rem; }
  .fetch-heading strong { color: var(--text-primary); font-size: .86rem; letter-spacing: .03em; }
  .fetch-heading strong span { color: var(--accent-blue); }
  .fetch-heading small { color: var(--text-muted); font-size: .56rem; letter-spacing: .09em; text-transform: uppercase; }

  .fetch-orbit { position: absolute; z-index: 0; top: -3.4rem; right: -3.2rem; width: 210px; aspect-ratio: 1; opacity: .34; pointer-events: none; }
  .orbit-axis { position: absolute; top: 50%; left: 50%; background: rgba(var(--blue-rgb), .28); transform: translate(-50%, -50%); }
  .orbit-axis-x { width: 100%; height: 1px; }
  .orbit-axis-y { width: 1px; height: 100%; }
  .orbit-ring { position: absolute; top: 50%; left: 50%; border: 1px solid rgba(var(--blue-rgb), .58); border-radius: 50%; transform: translate(-50%, -50%); }
  .orbit-ring::before, .orbit-ring::after { content: ''; position: absolute; width: 3px; height: 3px; border: 1px solid var(--accent-blue); background: var(--bg-1); transform: rotate(45deg); }
  .orbit-ring::before { top: 12%; left: 11%; }
  .orbit-ring::after { right: 7%; bottom: 19%; border-color: var(--accent-teal); }
  .orbit-ring i { position: absolute; top: -4px; left: 50%; width: 7px; height: 7px; border: 1px solid var(--accent-amber); border-radius: 50%; background: var(--bg-1); box-shadow: 0 0 9px rgba(var(--amber-rgb), .5); }
  .orbit-ring-outer { width: 86%; height: 86%; border-style: dashed; animation: orbit-spin 24s linear infinite; }
  .orbit-ring-inner { width: 58%; height: 58%; animation: orbit-spin 16s linear infinite reverse; }
  .orbit-ring-inner i { top: 50%; right: -4px; left: auto; border-color: var(--accent-teal); box-shadow: 0 0 9px rgba(var(--teal-rgb), .5); }
  .orbit-core { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 54px; height: 54px; color: var(--text-primary); border: 1px solid rgba(var(--amber-rgb), .65); border-radius: 7px 2px 7px 2px; background: rgba(var(--amber-rgb), .09); transform: translate(-50%, -50%) rotate(45deg); }
  .orbit-core b, .orbit-core small { transform: rotate(-45deg); }
  .orbit-core b { margin: 0 0 -1.3rem -.9rem; font-size: 1.2rem; }
  .orbit-core small { margin: -.7rem -.8rem 0 0; color: var(--accent-amber); font-size: .42rem; letter-spacing: .08em; }
  @keyframes orbit-spin { to { transform: translate(-50%, -50%) rotate(1turn); } }

  .fetch-list { position: relative; z-index: 2; margin: 0; }
  .fetch-list > div { display: grid; grid-template-columns: 112px minmax(0, 1fr); min-height: 29px; }
  .fetch-list dt { display: grid; grid-template-columns: 23px 1fr; align-items: center; padding: .37rem .5rem; color: var(--accent-teal); border-top: 1px solid rgba(var(--teal-rgb), .2); border-inline: 1px solid rgba(var(--teal-rgb), .48); background: color-mix(in srgb, var(--bg-1) 84%, transparent); font-size: .63rem; letter-spacing: .04em; }
  .fetch-list > div:first-child dt { border-radius: 6px 6px 0 0; }
