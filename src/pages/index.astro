---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getHomeConfig, getSiteConfig } from '../utils/config';
import { fetchCredlyBadges } from '../utils/credly';
import {
  Library, Server, FileText, Code, Globe, ExternalLink, Github,
  Calendar, MapPin
} from '@lucide/astro';

const config = getSiteConfig();
const portfolio = getHomeConfig();

// Fetch Credly badges at build time
let credlyBadges: any[] = [];
if (portfolio.credly?.enabled && portfolio.credly?.username) {
  try {
    credlyBadges = await fetchCredlyBadges(
      portfolio.credly.username,
      portfolio.credly.pinnedIds ?? [],
    );
  } catch (e) {
    console.warn('[Credly] Failed:', e);
  }
}

// Pinned badges come first (sorted by the order in pinnedIds); limit to 9.
const MAX_CERTS = 9;
const certifications = (credlyBadges.length > 0
  ? credlyBadges.map((b: any) => ({
      id:          b.id,
      title:       b.title,
      issuer:      b.issuer,
      date:        b.date,
      credly_url:  b.credlyUrl,
      badge_image: b.imageUrl,
      pinned:      b.pinned ?? false,
    }))
  : (portfolio.certifications || []))
  .slice(0, MAX_CERTS);

const sections = portfolio.sections || {};
const iconMap: Record<string, any> = { Library, Server, FileText, Code, Globe };

// Liens d'action du hero (déclarés en config mais jamais rendus jusqu'ici)
const heroLinks = (portfolio.heroLinks || []).filter((l: any) => l.enabled !== false);
const profile = portfolio.profile || {};
---

<BaseLayout title="Home" description={portfolio.profile?.tagline}>
  <div class="container portfolio">
    <!-- Terminal Banner -->
    <section class="banner-scene" aria-label="Introduction">
      <div class="banner-grid"></div>
      <div class="banner-blob banner-blob-1"></div>
      <div class="banner-blob banner-blob-2"></div>

      <div class="banner-card">
        <div class="banner-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="banner-bar">kitty — zsh</div>
        <div class="banner-vline"></div>

        <div class="banner-prompt">
          <span class="prompt-arrow">›</span>~/home
          <span class="prompt-on">on</span>
          <span class="prompt-distro"> opensuse</span>
        </div>

        <h1 class="banner-title">
          <span class="title-dot">.</span>{portfolio.profile?.pseudo}
        </h1>

        <div class="banner-tw-wrap">
          <span class="tw-prefix">›</span>
          <span class="banner-tw" id="tw"></span>
          <span class="banner-cursor"></span>
        </div>

        <div class="bottom-bar">
          <div class="meta">
            <div class="meta-item">
              <span class="lbl">date</span>
              <span class="val" id="date-disp">—</span>
            </div>
            <span class="meta-div">·</span>
            <div class="meta-item">
              <span class="lbl">uptime</span>
              <span class="val" id="uptime-disp">00:00:00</span>
            </div>
          </div>
          <div class="banner-tags">
            <span class="btag btag-accent">hyprland</span>
            <span class="btag btag-accent">openSUSE</span>
            <span class="btag">debian</span>
            <span class="btag btag-accent">proxmox</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro / about — surface la bio + les liens d'action (config) -->
    {(profile.bio || heroLinks.length > 0) && (
      <section class="intro reveal" aria-label="Présentation">
        <div class="intro-cmd">
          <span class="intro-prompt">›</span>
          <span class="intro-cmd-text">cat about.md</span>
        </div>
        {profile.title && (
          <p class="intro-role">{profile.title}</p>
        )}
        {profile.bio && (
          <p class="intro-bio">{profile.bio}</p>
        )}
        {heroLinks.length > 0 && (
          <div class="intro-actions">
            {heroLinks.map((link: any, i: number) => {
              const Icon = iconMap[link.icon];
              const isExternal = link.internal === false;
              return (
                <a
                  href={link.url}
                  class={`btn ${i === 0 ? 'btn-primary' : 'btn-outline'}`}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                >
                  {Icon && <Icon size={16} />}
                  {link.label}
                  {isExternal && <ExternalLink size={13} class="intro-action-ext" />}
                </a>
              );
            })}
          </div>
        )}
      </section>
    )}

    <!-- Projects -->
    {sections.projects && (
      <section class="section reveal" aria-label="Projets">
        <div class="section-header">
          <h2 class="term-head">
            <span class="term-tilde">~/</span><span class="term-name">projets</span><span class="term-caret" aria-hidden="true">▍</span>
            <span class="term-count"># {(portfolio.projects || []).length} entries</span>
          </h2>
          <div class="section-divider"></div>
        </div>
        <div class="projects-grid">
          {(portfolio.projects || []).map((project: any) => {
            const Icon = iconMap[project.icon];
            return (
              <article class="card project-card">
                <div class="project-cover">
                  {project.image ? (
                    <img
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                      decoding="async"
                      class="project-cover-img"
                    />
                  ) : (
                    <div class="project-cover-fallback" aria-hidden="true">
                      {Icon && <Icon size={40} />}
                    </div>
                  )}
                  <div class="project-cover-overlay"></div>
                  <div class="project-cover-meta">
                    <span class="project-chip project-chip-icon" aria-hidden="true">
                      {Icon && <Icon size={14} />}
                    </span>
                    <span class="project-chip project-chip-year">{project.year}</span>
                  </div>
                </div>

                <div class="project-body">
                  <h3 class="project-title">{project.title}</h3>
                  <p class="project-desc">{project.description}</p>
                  <div class="project-tags">
                    {(project.tech || []).map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <div class="project-links">
                    {project.link && (
                      <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
                        <ExternalLink size={14} />
                        Voir le projet
                      </a>
                    )}
                    {project.repo && (
                      <a href={project.repo} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
                        <Github size={14} />
                        Voir le code
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- Diplomas -->
    {sections.diplomas && (
      <section class="section reveal" aria-label="Diplômes">
        <div class="section-header">
          <h2 class="term-head">
            <span class="term-tilde">~/</span><span class="term-name">diplomes</span><span class="term-caret" aria-hidden="true">▍</span>
            <span class="term-count"># {(portfolio.diplomas || []).length} entries</span>
          </h2>
          <div class="section-divider"></div>
        </div>
        <div class="log-pane" role="list">
          {(portfolio.diplomas || []).map((dip: any) => (
            <article class="log-entry" role="listitem">
              <div class="log-head">
                <span class="log-time">[{dip.period}]</span>
                <span class="log-level log-level-ok">OK</span>
                <h3 class="log-title">{dip.title}</h3>
              </div>
              <div class="log-line">
                <span class="log-tree" aria-hidden="true">├─</span>
                <span class="log-label">@</span>
                <span class="log-value">{dip.institution}</span>
              </div>
              <div class="log-line">
                <span class="log-tree" aria-hidden="true">├─</span>
                <span class="log-label">info</span>
                <span class="log-value">{dip.description}</span>
              </div>
              {dip.tags && (
                <div class="log-line">
                  <span class="log-tree" aria-hidden="true">└─</span>
                  <span class="log-label">tags</span>
                  <span class="log-tags">
                    {dip.tags.map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </span>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Certifications & badges -->
    {sections.certifications && certifications.length > 0 && (
      <section class="section reveal" aria-label="Certifications &amp; badges">
        <div class="section-header">
          <h2 class="term-head">
            <span class="term-tilde">~/</span><span class="term-name">certifications</span><span class="term-caret" aria-hidden="true">▍</span>
            <span class="term-count"># {certifications.length} badges</span>
          </h2>
          <div class="section-divider"></div>
        </div>
        <div class="certs-grid">
          {certifications.map((cert: any) => (
            <a
              href={cert.credly_url}
              target="_blank"
              rel="noopener noreferrer"
              class={`cert-card${cert.pinned ? ' cert-card--featured' : ''}`}
            >
              <div class="cert-image-wrap">
                {/* Optimisé au build (webp, 88px = 2× l'affichage 44px pour
                    les écrans HiDPI) au lieu du PNG d'origine de Credly. */}
                <Image
                  src={cert.badge_image}
                  alt=""
                  inferSize
                  width={88}
                  height={88}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="cert-body">
                <p class="cert-title">
                  {cert.title}
                  {cert.pinned && (
                    <span class="cert-star" title="En vedette">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      <span class="sr-only">En vedette</span>
                    </span>
                  )}
                </p>
                {/* issuer et date sur une seule ligne : économise une ligne par carte */}
                <p class="cert-meta">
                  <span class="cert-issuer">{cert.issuer}</span>
                  <span class="cert-meta-sep" aria-hidden="true">·</span>
                  <span class="cert-date">{cert.date}</span>
                </p>
              </div>
              <svg class="cert-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Jobs -->
    {sections.jobs && (
      <section class="section reveal" aria-label="Expériences">
        <div class="section-header">
          <h2 class="term-head">
            <span class="term-tilde">~/</span><span class="term-name">experiences</span><span class="term-caret" aria-hidden="true">▍</span>
            <span class="term-count"># {(portfolio.jobs || []).length} entries</span>
          </h2>
          <div class="section-divider"></div>
        </div>
        <div class="log-pane" role="list">
          {(portfolio.jobs || []).map((job: any, i: number) => {
            // Heuristique : si "period" contient "-" mais pas un chiffre après, on considère actif
            const period = String(job.period || '');
            const isActive = /présent|present|now|en cours|today/i.test(period) || /-\s*$/.test(period);
            const level = isActive ? 'wip' : 'info';
            const levelLabel = isActive ? 'WIP' : 'INFO';
            return (
              <article class="log-entry" role="listitem">
                <div class="log-head">
                  <span class="log-time">[{job.period}]</span>
                  <span class={`log-level log-level-${level}`}>{levelLabel}</span>
                  <h3 class="log-title">{job.title}</h3>
                </div>
                <div class="log-line">
                  <span class="log-tree" aria-hidden="true">├─</span>
                  <span class="log-label">@</span>
                  <span class="log-value">
                    {job.company}
                    {job.location && (
                      <span class="job-location">
                        <MapPin size={11} /> {job.location}
                      </span>
                    )}
                  </span>
                </div>
                <div class="log-line">
                  <span class="log-tree" aria-hidden="true">└─</span>
                  <span class="log-label">info</span>
                  <span class="log-value">{job.description}</span>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </div>
</BaseLayout>


<style>
  .portfolio { max-width: 900px; padding-bottom: 4rem; }

  /* ══════════════════════════════
     INTRO / ABOUT
  ══════════════════════════════ */
  .intro {
    max-width: 760px;
    margin: 0 auto 4rem;
    padding-left: 1.25rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .intro-cmd {
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--muted-text);
    margin-bottom: 0.85rem;
    letter-spacing: 0.02em;
  }
  .intro-prompt { color: var(--link-color); margin-right: 0.4rem; }
  .intro-cmd-text { color: var(--text-secondary); }

  .intro-role {
    font-family: var(--font-code);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }

  .intro-bio {
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 1.6rem;
    max-width: 60ch;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .intro-action-ext { opacity: 0.65; }

  @media (max-width: 768px) {
    .intro {
      margin-bottom: 3rem;
      padding-left: 1rem;
    }
  }

  /* ══════════════════════════════
     BANNER SCENE
  ══════════════════════════════ */
  .banner-scene {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 3rem auto 3rem;
  }

  .banner-grid {
    position: absolute;
    inset: -60px;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
    animation: gridDrift 20s linear infinite;
    pointer-events: none;
  }
  @keyframes gridDrift { to { transform: translate(48px, 48px); } }

  .banner-blob {
    position: absolute; border-radius: 50%;
    filter: blur(60px); opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .banner-blob {
      filter: blur(30px);
    }
    .banner-grid {
      animation: none;
    }
  }
  .banner-blob-1 {
    width: 320px; height: 220px;
    background: radial-gradient(circle, var(--blob-teal) 0%, transparent 70%);
    top: -60px; left: -80px;
    animation: blobIn .8s ease .1s forwards;
  }
  .banner-blob-2 {
    width: 260px; height: 180px;
    background: radial-gradient(circle, var(--blob-salmon) 0%, transparent 70%);
    bottom: -40px; right: -40px;
    animation: blobIn .8s ease .4s forwards;
  }
  @keyframes blobIn { to { opacity: 1; } }

  /* ── Glass Card ── */
  .banner-card {
    position: relative; width: 100%;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow:
      0 0 0 1px var(--glass-edge),
      0 8px 48px var(--glass-shadow),
      inset 0 1px 0 var(--glass-inner);
    overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
    padding: 44px 56px 58px;
  }
  @media (max-width: 768px) {
    .banner-card {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--surface);
    }
  }
  .banner-card::before {
    content: ''; position: absolute; top: 0; right: 0;
    width: 280px; height: 130px;
    background: radial-gradient(ellipse at top right, var(--glass-glow), transparent 70%);
    border-radius: 0 20px 0 0; pointer-events: none;
  }
  .banner-card::after {
    content: ''; position: absolute; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--scan-color), transparent);
    top: 0;
    transform: translateY(-2px);
    animation: scanDown 6s ease-in-out 1.8s infinite;
  }
  @keyframes scanDown {
    0%   { transform: translateY(-2px); opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 1; }
    100% { transform: translateY(600px); opacity: 0; }
  }

  /* ── Terminal dots — pop + bounce ── */
  .banner-dots {
    position: absolute; top: 18px; left: 22px;
    display: flex; gap: 7px;
  }
  .banner-dots span {
    width: 11px; height: 11px; border-radius: 50%;
    opacity: 0;
    animation: dotPop .5s cubic-bezier(.36,.07,.19,.97) both;
  }
  .banner-dots span:nth-child(1) { background: var(--dot-r); animation-delay: .3s; }
  .banner-dots span:nth-child(2) { background: var(--dot-y); animation-delay: .46s; }
  .banner-dots span:nth-child(3) { background: var(--dot-g); animation-delay: .62s; }
  @keyframes dotPop {
    0%   { opacity: 0; transform: scale(0); }
    55%  { opacity: 1; transform: scale(1.4); }
    75%  { transform: scale(0.85); }
    90%  { transform: scale(1.08); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ── Win-bar — CRT flicker ── */
  .banner-bar {
    position: absolute; top: 15px; left: 0; right: 0;
    text-align: center; font-family: var(--font-code);
    font-size: 11px; color: var(--banner-muted);
    letter-spacing: .08em;
    opacity: 0;
    animation: flicker .7s ease .9s forwards;
  }
  @keyframes flicker {
    0%   { opacity: 0; }
    15%  { opacity: .5; }
    20%  { opacity: 0; }
    38%  { opacity: .7; }
    42%  { opacity: .1; }
    58%  { opacity: 1; }
    100% { opacity: 1; }
  }

  /* ── Vertical line — draws top to bottom ── */
  .banner-vline {
    position: absolute; left: 46px; top: 48px; bottom: 46px;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--banner-teal-dim) 30%, var(--banner-teal-dim) 70%, transparent);
    transform-origin: top center;
    opacity: 0;
    animation: drawLine .6s ease .8s forwards;
  }
  @keyframes drawLine {
    from { transform: scaleY(0); opacity: 0; }
    5%   { opacity: 1; }
    to   { transform: scaleY(1); opacity: 1; }
  }

  /* ── Prompt — slides from left ── */
  .banner-prompt {
    font-family: var(--font-code); font-size: 12px;
    color: var(--banner-teal-dim); letter-spacing: .06em;
    margin-bottom: 8px; opacity: 0;
    animation: fromLeft .45s ease 1s forwards;
  }
  .prompt-arrow { color: var(--banner-salmon); margin-right: 6px; }
  .prompt-on { color: var(--banner-muted); }
  .prompt-distro { color: var(--banner-salmon); }
  @keyframes fromLeft {
    from { opacity: 0; transform: translateX(-20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── Title — clip-path wipe ── */
  .banner-title {
    font-family: 'JetBrains Mono', var(--font-code), monospace;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    font-weight: 700; color: var(--banner-text);
    letter-spacing: -.02em; line-height: 1;
    margin-bottom: 18px;
    clip-path: inset(0 100% 0 0);
    animation: wipeIn .55s cubic-bezier(.77,0,.18,1) 1.2s forwards;
  }
  .title-dot { color: var(--banner-teal); }
  @keyframes wipeIn {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0% 0 0); }
  }

  /* ── Typewriter — glitch entrance ── */
  .banner-tw-wrap {
    display: flex; align-items: center; gap: 8px;
    min-height: 24px;
    opacity: 0;
    animation: glitchIn .5s ease 1.75s forwards;
  }
  .tw-prefix { color: var(--banner-teal-dim); font-family: var(--font-code); font-size: 13px; flex-shrink: 0; }
  .banner-tw {
    font-family: var(--font-code); font-size: 13px;
    color: var(--banner-text-dim); letter-spacing: .04em;
    white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; max-width: 100%;
  }
  .banner-cursor {
    display: inline-block; width: 8px; height: 14px;
    background: var(--banner-teal); vertical-align: middle;
    margin-left: 2px; flex-shrink: 0;
    animation: blink .7s step-end infinite;
  }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes glitchIn {
    0%   { opacity: 0; transform: translateX(6px) skewX(4deg); }
    30%  { opacity: .8; transform: translateX(-3px) skewX(-2deg); }
    55%  { opacity: .5; transform: translateX(2px) skewX(1deg); }
    80%  { opacity: .95; transform: translateX(-1px) skewX(0deg); }
    100% { opacity: 1; transform: translateX(0) skewX(0deg); }
  }

  /* ── Bottom bar — rises from below ── */
  .bottom-bar {
    position: absolute; bottom: 14px; left: 24px; right: 24px;
    display: flex; justify-content: space-between; align-items: center; gap: 10px;
    opacity: 0;
    animation: riseUp .5s ease 2.1s forwards;
  }
  @keyframes riseUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .meta { display: flex; gap: 12px; align-items: center; flex-shrink: 0; }
  .meta-item {
    font-family: var(--font-code); font-size: 10px; color: var(--banner-muted);
    letter-spacing: .06em; display: flex; align-items: center; gap: 4px;
  }
  .meta-item .lbl { opacity: .55; }
  .meta-item .val { color: var(--banner-teal-dim); }
  .meta-div { color: var(--banner-muted); opacity: .3; font-size: 10px; }

  /* ── Tags (inside bottom-bar) ── */
  .banner-tags { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .btag {
    font-family: var(--font-code); font-size: 10px;
    color: var(--banner-muted);
    border: 1px solid var(--banner-muted);
    padding: 2px 8px; border-radius: 4px;
    letter-spacing: .09em; text-transform: uppercase;
    cursor: pointer; user-select: none;
