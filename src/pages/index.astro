<script>
  const commands = ['terraform plan', 'kubectl get nodes', 'ansible-playbook deploy.yml', 'podman ps --format table'];
  let commandTimer: number | undefined;
  let uptimeTimer: number | undefined;
  let pageStarted = Date.now();

  function initHome() {
    window.clearInterval(commandTimer); window.clearInterval(uptimeTimer); pageStarted = Date.now();
    const command = document.querySelector<HTMLElement>('#hero-command');
    const time = document.querySelector<HTMLElement>('#local-time');
    const uptime = document.querySelector<HTMLElement>('#page-uptime');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let commandIndex = 0;
    const updateClock = () => {
      if (time) time.textContent = new Intl.DateTimeFormat('fr-BE', { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(new Date());
      if (uptime) { const elapsed = Math.floor((Date.now() - pageStarted) / 1000); uptime.textContent = `${String(Math.floor(elapsed / 60)).padStart(2, '0')}:${String(elapsed % 60).padStart(2, '0')}`; }
    };
    updateClock(); uptimeTimer = window.setInterval(updateClock, 1000);
    if (command && !reduceMotion) {
      commandTimer = window.setInterval(() => {
        command.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-5px)' }], { duration: 180, fill: 'forwards' }).finished.then(() => {
          commandIndex = (commandIndex + 1) % commands.length; command.textContent = commands[commandIndex];
          command.animate([{ opacity: 0, transform: 'translateY(5px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 220, fill: 'forwards' });
        });
      }, 3200);
    }
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
      card.onpointermove = (event) => { if (reduceMotion) return; const rect = card.getBoundingClientRect(); card.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`); card.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`); };
    });
    const nodes = document.querySelectorAll<HTMLButtonElement>('[data-lab-node]');
    const eyebrow = document.querySelector<HTMLElement>('#node-eyebrow'); const title = document.querySelector<HTMLElement>('#node-title');
    const text = document.querySelector<HTMLElement>('#node-text'); const tech = document.querySelector<HTMLElement>('#node-tech');
    nodes.forEach((node) => { node.onclick = () => {
      nodes.forEach((item) => { const selected = item === node; item.classList.toggle('active', selected); item.setAttribute('aria-pressed', String(selected)); });
      if (eyebrow) eyebrow.textContent = node.dataset.eyebrow || ''; if (title) title.textContent = node.dataset.title || '';
      if (text) text.textContent = node.dataset.text || ''; if (tech) tech.textContent = node.dataset.tech || '';
    }; });
  }
  initHome(); document.addEventListener('astro:page-load', initHome);
</script>
