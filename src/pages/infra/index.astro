---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInfraConfig, isFeatureEnabled } from '../../utils/config';
import {
  Server, Network, Boxes, Cpu, HardDrive, Globe,
  Shield, ExternalLink, Lock, ArrowUpRight, Terminal,
  Router, Wifi, Monitor, GitBranch, Workflow, Printer,
} from '@lucide/astro';

if (!isFeatureEnabled('infra')) {
  return Astro.redirect('/');
}

const infra = getInfraConfig();
const page = infra.page;
const tabs = infra.tabs || {};
const enabledTabs = Object.entries(tabs).filter(([_, v]: any) => v.enabled);
const initialTabKey = enabledTabs[0]?.[0] || 'services';

const colorMap: Record<string, string> = {
  cyan: '#5ecfba', purple: '#b08fcf', green: '#7fd9c0',
  red: '#e07d6a', orange: '#e0a86a', blue: '#6ab0e0',
};
const iconMap: Record<string, any> = {
  Server, Network, Boxes, Cpu, HardDrive, Globe, Shield, Lock,
  Router, Wifi, Monitor, GitBranch, Workflow, Printer,
};

const wan = infra.wanExposure || {};
const serviceCount = (infra.serviceGroups || []).reduce(
  (total: number, group: any) => total + (group.services || []).length,
  0,
);

// Group serviceGroups by physical node for hierarchical /srv view
const allPhysicalNodes: any[] = [...(infra.proxmoxNodes || []), ...(infra.networkDevices || [])];
const srvByNode: Record<string, any[]> = (infra.serviceGroups || []).reduce(
  (acc: Record<string, any[]>, group: any) => {
    if (!acc[group.node]) acc[group.node] = [];
    acc[group.node].push(group);
    return acc;
  }, {}
);
const srvNodeEntries = allPhysicalNodes.map((node: any) => {
  const fallbackGroup = node.services?.length ? [{
    vm: node.name,
    node: node.name,
    type: 'Natif',
    services: node.services.map((service: any) => ({ ...service, status: 'online', description: service.type })),
  }] : [];
  return { name: node.name, specs: node, vmGroups: srvByNode[node.name] || fallbackGroup };
}).filter((node: any) => node.vmGroups.length > 0);

const tabCounts: Record<string, number> = {
  services: serviceCount,
  lan: (infra.vlans || []).length,
  wan: (wan.exposedServices || []).length,
};
const tabMeta = Object.fromEntries(Object.entries(tabs).map(([key, tab]: any) => [key, {
  ...tab,
  icon: iconMap[tab.icon],
  count: tabCounts[key] || 0,
}]));
const categoryEntries = Object.entries(infra.vlanCategories || {});
const docLinks: Record<string, string> = infra.documentation.serviceLinks || {};
---

<BaseLayout title={page.title} description={page.description}>
  <div class="container infra-page">
    <header class="infra-hero">
      <div>
        <p class="infra-path"><span>~/</span>{page.path} <i aria-hidden="true">▍</i></p>
        <h1>{page.heading}<br /><em>{page.headingAccent}</em></h1>
        <p class="infra-lead">{page.introduction}</p>
        <div class="infra-actions">
          <a href="#explorer">{page.explorerLabel} <span aria-hidden="true">↓</span></a>
          <a href={infra.documentation.url} target="_blank" rel="noopener noreferrer">{infra.documentation.label} <ArrowUpRight size={15} /></a>
        </div>
      </div>
      <aside class="infra-terminal" aria-label="Résumé de l’infrastructure">
        <div><Terminal size={14} /><span>{page.terminalTitle}</span><span class="infra-online"><i></i> {page.terminalStatus}</span></div>
        <code><span>$</span> pvesh get /nodes<br /><b>{(infra.proxmoxNodes || []).length} nodes</b> ready</code>
        <code><span>$</span> ip -brief link<br /><b>{(infra.vlans || []).length} VLANs</b> isolated</code>
        <code><span>$</span> systemctl list-units<br /><b>{serviceCount} services</b> documented</code>
      </aside>
    </header>

    <!-- Stats banner -->
    <div class="stats-banner">
      <div class="stats-grid">
        <div class="stat-card" style="--stat-color: #d4845a; --stat-delay: 0s">
          <div class="stat-icon"><Cpu size={22} /></div>
          <div class="stat-body">
            <span class="stat-value">{infra.stats?.totalCpuCores}</span>
            <span class="stat-label">CPU Cores</span>
          </div>
          <div class="stat-bar"></div>
        </div>
        <div class="stat-card" style="--stat-color: #5ecfba; --stat-delay: 0.08s">
          <div class="stat-icon"><Server size={22} /></div>
          <div class="stat-body">
            <span class="stat-value">{infra.stats?.totalRamGB} <small>Go</small></span>
            <span class="stat-label">DDR4</span>
          </div>
          <div class="stat-bar"></div>
        </div>
        <div class="stat-card" style="--stat-color: #b08fcf; --stat-delay: 0.16s">
          <div class="stat-icon"><Boxes size={22} /></div>
          <div class="stat-body">
            <span class="stat-value">{infra.stats?.cephStorage}</span>
            <span class="stat-label">CEPH</span>
          </div>
          <div class="stat-bar"></div>
        </div>
        <div class="stat-card" style="--stat-color: #6ab0e0; --stat-delay: 0.24s">
          <div class="stat-icon"><HardDrive size={22} /></div>
          <div class="stat-body">
            <span class="stat-value">{infra.stats?.nasStorage}</span>
            <span class="stat-label">NAS</span>
          </div>
          <div class="stat-bar"></div>
        </div>
        <div class="stat-card" style="--stat-color: #7fd9c0; --stat-delay: 0.32s">
          <div class="stat-icon"><Network size={22} /></div>
          <div class="stat-body">
            <span class="stat-value">{(infra.vlans || []).length}</span>
            <span class="stat-label">VLANs</span>
          </div>
          <div class="stat-bar"></div>
        </div>
      </div>
    </div>

    <!-- Explorateur de l’infrastructure -->
    <div class="tabs-frame" id="explorer">
      <div class="tab-context">
        <span class="tab-command"><i aria-hidden="true">$</i> cd <strong id="active-tab-path">~/{tabMeta[initialTabKey]?.hash}</strong></span>
        <span class="tab-description" id="active-tab-description" aria-live="polite">{tabMeta[initialTabKey]?.description}</span>
        <span class="tab-ready"><i aria-hidden="true"></i> ready</span>
      </div>
      <div class="tabs" role="tablist" aria-label="Explorer l’infrastructure">
        <span class="tab-indicator" aria-hidden="true"></span>
      {enabledTabs.map(([key, tab]: any, i: number) => (
        <button
          class:list={['tab', { active: i === 0 }]}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${key}`}
          id={`tab-${key}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={key}
          data-hash={tabMeta[key]?.hash || key}
          data-description={tabMeta[key]?.description || ''}
        >
          {(() => {
            const Icon = tabMeta[key]?.icon;
            return Icon && <Icon size={16} aria-hidden="true" />;
          })()}
          <span class="tab-label">{tab.label}</span>
          <span class="tab-count" aria-label={`${tabMeta[key]?.count || 0} ${tabMeta[key]?.countLabel || 'éléments'}`}>
            {tabMeta[key]?.count || 0}
          </span>
        </button>
      ))}
      </div>
    </div>

    <!-- LAN Tab -->
    {tabs.lan?.enabled && (
      <div class:list={['tab-panel', { 'active-panel': initialTabKey === 'lan' }]} data-panel="lan" role="tabpanel" id="panel-lan" aria-labelledby="tab-lan">
        <h2 class="term-head-path"><span class="term-tilde">~/</span><span class="gradient-text">lan</span></h2>
        {categoryEntries.map(([cat, category]: any, ci) => {
          const categoryVlans = (infra.vlans || []).filter((v: any) => v.category === cat);
          if (categoryVlans.length === 0) return null;
          return (
            <div class="vlan-category slide-in" style={`--stage-delay: ${ci * 0.05}s`}>
              <div class="vlan-cat-header" style={`--cat-color: ${colorMap[category.color] || 'var(--accent)'}`}>
                <span class="vlan-cat-badge">{category.label}</span>
                <span class="vlan-cat-count">{categoryVlans.length}</span>
              </div>
              <div class="vlans-grid">
                {categoryVlans.map((vlan: any, vi: number) => (
                  <div class="card vlan-card slide-in" style={`border-left: 3px solid ${colorMap[vlan.color] || 'var(--accent)'}; --stage-delay: ${ci * 0.05 + vi * 0.04}s`}>
                    <div class="vlan-header">
                      <h4>{iconMap[vlan.icon] && (() => { const Icon = iconMap[vlan.icon]; return <Icon size={14} aria-hidden="true" />; })()}{vlan.name}</h4>
                      <span class="tag">{vlan.subnet}</span>
                    </div>
                    <div class="vlan-devices">
                      {(vlan.devices || []).map((dev: string) => (
                        <span class="vlan-device">{dev}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- WAN Tab -->
    {tabs.wan?.enabled && (() => {
      /* Group exposed services by VM */
      const svcByVm = (wan.exposedServices || []).reduce((acc: any, svc: any) => {
        const key = svc.vm;
        if (!acc[key]) acc[key] = { vm: svc.vm, node: svc.node, services: [] };
        acc[key].services.push(svc);
        return acc;
      }, {});
      const vmGroups = Object.values(svcByVm) as any[];

      return (
        <div class:list={['tab-panel', { 'active-panel': initialTabKey === 'wan' }]} data-panel="wan" role="tabpanel" id="panel-wan" aria-labelledby="tab-wan">
          <h2 class="term-head-path"><span class="term-tilde">~/</span><span class="gradient-text">wan</span></h2>
          {wan.description && <p class="wan-description">{wan.description}</p>}

          <!-- Schema diagram -->
          <div class="wan-schema">
            {(wan.chain || []).map((step: any, index: number) => {
              const Icon = iconMap[step.icon] || Network;
              return (
                <>
                  <div class="schema-row slide-in" style={`--stage-delay: ${index * 0.06}s`}>
                    <div class="schema-node schema-config" style={`--schema-color: ${colorMap[step.color] || 'var(--accent)'}`}>
                      <Icon size={18} aria-hidden="true" />
                      <div class="schema-node-content">
                        <span class="schema-node-title">{step.step}</span>
                        <span class="schema-node-sub">{step.description}</span>
                        {step.features?.length > 0 && (
                          <details class="schema-features">
                            <summary>{step.features.length} contrôles</summary>
                            <ul>{step.features.map((feature: string) => <li>{feature}</li>)}</ul>
                          </details>
                        )}
                      </div>
                    </div>
                  </div>
                  {index < wan.chain.length - 1 && <div class="schema-connector-v"></div>}
                </>
              );
            })}

            <!-- Fan-out lines -->
            <div class="schema-fanout">
              <div class="schema-fanout-line"></div>
            </div>

            <!-- VMs with Traefik -->
            <div class="schema-vms-row slide-in" style="--stage-delay: 0.2s">
              {vmGroups.map((group: any) => (
                <div class="schema-vm-col">
                  <div class="schema-node schema-traefik">
                    <Network size={16} />
                    <div class="schema-node-content">
                      <span class="schema-node-title">Traefik</span>
                      <span class="schema-node-sub">{group.vm} @ {group.node}</span>
                    </div>
                  </div>
                  <div class="schema-connector-v schema-connector-sm"></div>
                  <div class="schema-services-list">
                    {group.services.map((svc: any) => (
                      <div class="schema-service">
                        <span class="schema-svc-dot"></span>
                        <span class="schema-svc-name">{svc.name}<small>{svc.domain}</small></span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      );
    })()}

    <!-- Services / Rack Tab (merged infrastructure + services) -->
    {tabs.services?.enabled && (
      <div class:list={['tab-panel', { 'active-panel': initialTabKey === 'services' }]} data-panel="services" role="tabpanel" id="panel-services" aria-labelledby="tab-services">
        <h2 class="sr-only">Services et nœuds</h2>
        <div class="rack-nodes">
          {srvNodeEntries.map((node: any, ni: number) => {
            const nodeColor = colorMap[node.specs?.color] || 'var(--accent)';
            const totalSvcs = node.vmGroups.reduce((a: number, g: any) => a + g.services.length, 0);
            const isPve = (infra.proxmoxNodes || []).some((n: any) => n.name === node.name);
            const NodeIcon = iconMap[node.specs?.icon] || (isPve ? Server : Network);
            return (
              <div class="rack-node slide-in" style={`--node-color: ${nodeColor}; --stage-delay: ${ni * 0.1}s`}>
                <div class="rack-node-header">
                  <span class="rack-led" aria-hidden="true"></span>
                  <span class="rack-node-icon" aria-hidden="true"><NodeIcon size={14} /></span>
                  <div class="rack-identity">
                    <span class="rack-node-name">{node.name}</span>
                    <span class:list={['rack-node-type', isPve ? 'rack-node-type--pve' : 'rack-node-type--device']}>
                      {isPve ? 'PVE' : 'device'}
                    </span>
                  </div>
                  <div class="rack-hw">
                    {node.specs?.cpu && <span class="rack-hw-chip"><Cpu size={10} />{node.specs.cpu}</span>}
                    {node.specs?.ram && <span class="rack-hw-chip">{node.specs.ram}</span>}
                  </div>
                  <span class="rack-svc-count">{totalSvcs} svc</span>
                </div>
                <div class="rack-vms">
                  {node.vmGroups.map((group: any) => {
                    const typeKey = group.type === 'VM' ? 'vm' : group.type === 'LXC' ? 'lxc' : 'natif';
                    return (
                      <div class="rack-vm-row" style={`--group-color: ${colorMap[group.color] || nodeColor}`}>
                        <span class:list={['rack-vm-type', `rack-vm-type--${typeKey}`]}>{group.type}</span>
                        <span class="rack-vm-name">{group.vm}</span>
                        <div class="rack-chips">
                          {(group.services || []).map((svc: any) => {
                            const docUrl = docLinks[svc.name];
                            return docUrl ? (
                              <a href={docUrl} class:list={['rack-chip', 'rack-chip--doc']} target="_blank" rel="noopener noreferrer" title={svc.description}>
                                <span class:list={['rack-chip-dot', `status-${svc.status}`]}></span>
                                {svc.name}<ExternalLink size={8} class="rack-ext-icon" />
                              </a>
                            ) : (
                              <span class="rack-chip" title={svc.description}>
                                <span class:list={['rack-chip-dot', `status-${svc.status}`]}></span>
                                {svc.name}
                              </span>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

  </div>
</BaseLayout>

<style>
  .infra-page { max-width: 1100px; padding-top: 3.5rem; padding-bottom: 4rem; }

  .infra-hero {
    display: grid;
    grid-template-columns: 1.15fr .7fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    min-height: 530px;
    padding: 3rem 0 4.5rem;
  }

  .infra-path {
    margin: 0;
    color: var(--text-muted);
    font: 650 .78rem var(--font-code);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .infra-path span { color: var(--accent-blue); }
  .infra-path i { color: var(--accent-amber); font-style: normal; animation: infra-caret 1.1s steps(1) infinite; }
  @keyframes infra-caret { 50% { opacity: 0; } }

  .infra-hero h1 {
    margin: .8rem 0 1.25rem;
    font-size: clamp(3rem, 6.5vw, 5.7rem);
    line-height: .95;
    letter-spacing: -.065em;
  }
  .infra-hero h1 em { color: var(--accent-amber); font-style: normal; }
  .infra-lead { max-width: 60ch; margin: 0; color: var(--text-secondary); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.65; }
  .infra-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.6rem; }
  .infra-actions a { display: inline-flex; align-items: center; gap: .45rem; min-height: 43px; padding: .65rem .8rem; color: var(--text-primary); border: 1px solid var(--glass-border); border-radius: 8px; background: var(--glass-bg); font: 650 .72rem var(--font-code); text-decoration: none; }
  .infra-actions a:first-child { color: var(--bg-0); background: var(--accent-amber); border-color: var(--accent-amber); }
  .infra-actions a:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }

  .infra-terminal { overflow: hidden; border: 1px solid var(--glass-border); border-radius: 16px; background: color-mix(in srgb, var(--glass-bg-strong) 90%, transparent); box-shadow: var(--shadow), inset 0 1px var(--glint); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); }
  .infra-terminal > div { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .5rem; padding: .75rem .9rem; color: var(--text-muted); border-bottom: 1px solid var(--glass-border); font: .65rem var(--font-code); }
  .infra-online { display: inline-flex; align-items: center; gap: .35rem; color: var(--accent-teal); }
  .infra-online i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 9px currentColor; }
  .infra-terminal code { display: block; padding: 1rem; color: var(--text-secondary); border-bottom: 1px solid color-mix(in srgb, var(--glass-border) 60%, transparent); font: .72rem/1.75 var(--font-code); }
  .infra-terminal code:last-child { border-bottom: 0; }
  .infra-terminal code span { color: var(--accent-teal); }
  .infra-terminal code b { color: var(--text-primary); font-weight: 650; }

  #explorer { scroll-margin-top: 6rem; }

  /* slide-in is CSS-driven (tab switch); reveal = scroll-driven animation CSS (global.css) */
  .slide-in { animation: slideIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--stage-delay, 0s); }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Stats banner ── */
  .stats-banner {
    margin-bottom: 2rem;
  }
  .stats-grid {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem;
  }
  .stat-card {
    position: relative; overflow: hidden;
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.9rem 1rem;
    background: var(--card-bg); 
    border: 1px solid var(--card-border); border-radius: 0.85rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    animation: statPop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--stat-delay, 0s);
  }
  @media (max-width: 768px) {
    .stat-card {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--surface);
    }
  }
  @keyframes statPop {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to   { opacity: 1; transform: none; }
  }
  .stat-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--stat-color) 40%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--stat-color) 10%, transparent),
                0 0 0 1px color-mix(in srgb, var(--stat-color) 15%, transparent);
  }
  .stat-bar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--stat-color), transparent);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .stat-card:hover .stat-bar { opacity: 0.7; }
  .stat-icon {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; flex-shrink: 0;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--stat-color) 10%, transparent);
    color: var(--stat-color);
    transition: background 0.3s ease;
  }
  .stat-card:hover .stat-icon {
    background: color-mix(in srgb, var(--stat-color) 18%, transparent);
  }
  .stat-body { min-width: 0; }
  .stat-value {
    font-family: var(--font-code); font-size: 1.15rem; font-weight: 700;
    color: var(--text); display: block; line-height: 1.2;
  }
  .stat-value small { font-size: 0.7rem; font-weight: 400; color: var(--muted-text); }
  .stat-label { font-size: 0.65rem; color: var(--muted-text); text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-top: 0.1rem; }

  /* Explorateur à onglets */
  .tabs-frame {
    position: sticky;
    top: 4.7rem;
    z-index: 20;
    margin: 2rem 0 2.5rem;
    scroll-margin-top: 6rem;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--glass-bg-strong) 92%, transparent);
    box-shadow: 0 14px 38px -28px rgba(0,0,0,.7), inset 0 1px var(--glint);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .tab-context {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.2rem;
    min-height: 39px;
    padding: .45rem .75rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--glass-border);
    font: .64rem/1.4 var(--font-code);
  }
  .tab-command { white-space: nowrap; }
  .tab-command i { color: var(--accent-teal); font-style: normal; font-weight: 700; }
  .tab-command strong { color: var(--text-primary); font-weight: 600; }
  .tab-description { overflow: hidden; text-align: center; white-space: nowrap; text-overflow: ellipsis; }
  .tab-ready { display: inline-flex; align-items: center; gap: .35rem; color: var(--accent-teal); text-transform: uppercase; letter-spacing: .08em; }
  .tab-ready i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; box-shadow: 0 0 9px rgba(var(--teal-rgb), .65); }

  .tabs {
    position: relative;
    display: flex;
    gap: .25rem;
    margin: 0;
    padding: .3rem;
    overflow-x: auto;
    border: 0;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab-indicator {
    position: absolute;
    top: .3rem;
    left: 0;
    width: 0;
    height: calc(100% - .6rem);
    border: 1px solid rgba(var(--amber-rgb), .35);
    border-radius: 9px;
    background: linear-gradient(135deg, rgba(var(--amber-rgb), .15), rgba(var(--blue-rgb), .07));
    box-shadow: inset 0 -2px var(--accent-amber), inset 0 1px var(--glint);
    transform: translateX(0);
    transition: transform .34s cubic-bezier(.22,1,.36,1), width .34s cubic-bezier(.22,1,.36,1);
    pointer-events: none;
  }
  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    flex: 1 0 auto;
    justify-content: center;
    min-height: 48px;
    padding: .62rem 1rem;
    color: var(--text-muted);
    border: 1px solid transparent;
    border-radius: 9px;
    background: none;
    font: 600 .76rem var(--font-code);
    cursor: pointer;
    transition: color .2s ease, transform .2s ease;
  }
  .tab:hover { color: var(--text-primary); transform: translateY(-1px); }
  .tab.active { color: var(--text-primary); }
  .tab.active > svg { color: var(--accent-amber); }
  .tab > svg { color: var(--accent-blue); transition: color .2s ease; }
  .tab-count {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 20px;
    padding: 0 .35rem;
    color: var(--text-muted);
    border: 1px solid var(--glass-border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg-1) 75%, transparent);
    font-size: .6rem;
  }
  .tab.active .tab-count { color: var(--accent-amber); border-color: rgba(var(--amber-rgb), .35); }

  @media (scripting: enabled) {
    .tab-panel:not(.active-panel) { display: none; }
  }
  .tab-panel.active-panel { transform-origin: 50% 0; }

  .spec { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-code); font-size: 0.78rem; color: var(--muted-text); }

  /* ── VLANs (/lan) ── */
