  .rack-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; padding: 0.18rem 0; }
  .rack-chip {
    display: inline-flex; align-items: center; gap: 0.28rem;
    font-size: 0.71rem; font-weight: 500; color: var(--text);
