    .tab-label { font-size: .7rem; }
    .tab { min-width: 108px; padding-inline: .65rem; }
    .stats-grid { grid-template-columns: 1fr; }
    .stat-card:last-child { grid-column: span 1; }
    .rack-vm-row { grid-template-columns: 46px 1fr; }
    .rack-vm-name { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .infra-path i { animation: none; }
    .tab-indicator, .tab { transition: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .infra-terminal, .tabs-frame { background: var(--bg-1); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
</style>

<script>
  const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function moveIndicator(tab: HTMLButtonElement) {
    const frame = tab.closest<HTMLElement>('.tabs-frame');
    const indicator = frame?.querySelector<HTMLElement>('.tab-indicator');
    if (!indicator) return;
    indicator.style.width = `${tab.offsetWidth}px`;
    indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
  }

  function activateInfraTab(
    tab: HTMLButtonElement,
    options: { animate?: boolean; updateUrl?: boolean; revealTab?: boolean } = {},
  ) {
    const frame = tab.closest<HTMLElement>('.tabs-frame');
    if (!frame) return;
    const tabs = [...frame.querySelectorAll<HTMLButtonElement>('.tab')];
    const panels = [...document.querySelectorAll<HTMLElement>('.infra-page .tab-panel')];
    const previous = tabs.findIndex((item) => item.classList.contains('active'));
    const next = tabs.indexOf(tab);
    const target = tab.dataset.tab;
    const panel = panels.find((item) => item.dataset.panel === target);
    if (!panel) return;

    tabs.forEach((item) => {
      const selected = item === tab;
      item.classList.toggle('active', selected);
      item.setAttribute('aria-selected', String(selected));
      item.setAttribute('tabindex', selected ? '0' : '-1');
    });
    panels.forEach((item) => {
      const selected = item === panel;
      item.classList.toggle('active-panel', selected);
      item.hidden = !selected;
      item.setAttribute('aria-hidden', String(!selected));
    });

    const hash = tab.dataset.hash || target || '';
    const path = frame.querySelector<HTMLElement>('#active-tab-path');
    const description = frame.querySelector<HTMLElement>('#active-tab-description');
    if (path) path.textContent = `~/${hash}`;
    if (description) description.textContent = tab.dataset.description || '';

    moveIndicator(tab);
    if (options.revealTab) tab.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
    if (options.updateUrl && hash) history.replaceState(null, '', `${location.pathname}${location.search}#${hash}`);

    if (options.animate !== false && !reducedMotion()) {
      const direction = previous <= next ? 1 : -1;
      panel.animate(
        [
          { opacity: 0, transform: `translate3d(${direction * 18}px, 8px, 0) scale(.992)` },
          { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
        ],
        { duration: 360, easing: 'cubic-bezier(.22, 1, .36, 1)' },
      );
    }
  }

  function initInfraTabs() {
    const frame = document.querySelector<HTMLElement>('.tabs-frame');
    if (!frame) return;
    const tabs = [...frame.querySelectorAll<HTMLButtonElement>('.tab')];
    const requested = location.hash.slice(1);
    const initial = tabs.find((tab) => tab.dataset.hash === requested)
      || tabs.find((tab) => tab.classList.contains('active'))
      || tabs[0];
    if (!initial) return;
    activateInfraTab(initial, { animate: false, updateUrl: false });
    requestAnimationFrame(() => moveIndicator(initial));
    if (requested && tabs.some((tab) => tab.dataset.hash === requested)) {
      requestAnimationFrame(() => frame.scrollIntoView({ block: 'start' }));
    }
  }

  function handleTabClick(event: MouseEvent) {
    const tab = (event.target as Element).closest<HTMLButtonElement>('.tabs-frame .tab');
    if (!tab) return;
    activateInfraTab(tab, { updateUrl: true, revealTab: true });
  }

  function handleTabKeydown(event: KeyboardEvent) {
    const tab = (event.target as Element).closest<HTMLButtonElement>('.tabs-frame .tab');
    if (!tab || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    const tabs = [...tab.closest<HTMLElement>('.tabs')!.querySelectorAll<HTMLButtonElement>('.tab')];
    if (!tabs.length) return;
    event.preventDefault();
    const current = tabs.indexOf(tab);
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
      : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    tabs[next].focus();
    activateInfraTab(tabs[next], { updateUrl: true, revealTab: true });
  }

  function handleInfraHash() {
    const hash = location.hash.slice(1);
    const tab = [...document.querySelectorAll<HTMLButtonElement>('.tabs-frame .tab')]
      .find((item) => item.dataset.hash === hash);
    if (tab) activateInfraTab(tab, { updateUrl: false, revealTab: true });
  }

  document.addEventListener('click', handleTabClick);
  document.addEventListener('keydown', handleTabKeydown);
  document.addEventListener('astro:page-load', initInfraTabs);
  window.addEventListener('hashchange', handleInfraHash);
  window.addEventListener('resize', () => {
    const active = document.querySelector<HTMLButtonElement>('.tabs-frame .tab.active');
    if (active) moveIndicator(active);
  });
  initInfraTabs();
</script>
