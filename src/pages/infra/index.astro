  .rack-vm-type--vm    { background: rgba(212,132,90,0.12); color: #d4845a; border: 1px solid rgba(212,132,90,0.22); }
  .rack-vm-type--lxc   { background: rgba(94,207,186,0.12); color: #5ecfba; border: 1px solid rgba(94,207,186,0.22); }
  .rack-vm-type--natif { background: rgba(127,217,192,0.12); color: #7fd9c0; border: 1px solid rgba(127,217,192,0.22); }

  .rack-vm-name {
