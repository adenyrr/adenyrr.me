  .rack-chip-dot {
    width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0;
    background: var(--muted-text);
  }
  .rack-chip-dot.status-online  { background: #5ecfba; box-shadow: 0 0 4px rgba(94,207,186,0.45); }
  .rack-chip-dot.status-offline { background: #e07d6a; }

  .rack-chip--doc {
    text-decoration: none;
    background: color-mix(in srgb, var(--link-color) 8%, transparent);
    border-color: color-mix(in srgb, var(--link-color) 30%, transparent);
    color: var(--text);
  }
  .rack-chip--doc:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .rack-ext-icon { opacity: 0.45; flex-shrink: 0; }
  .rack-chip--doc:hover .rack-ext-icon { opacity: 1; }

  .hidden { display: none !important; }

  @media (max-width: 768px) {
    .infra-page { padding-top: 2.5rem; }
    .infra-hero { grid-template-columns: 1fr; min-height: auto; padding: 3rem 0 4rem; }
    .infra-terminal { max-width: 560px; }
    .tabs-frame { top: 4.1rem; margin-inline: -.15rem; }
    .tab-context { grid-template-columns: 1fr auto; }
    .tab-description { display: none; }
    .tab { min-width: 118px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stat-card:last-child { grid-column: span 2; }
    .vlans-grid { grid-template-columns: 1fr; }
    .schema-vms-row { flex-direction: column; align-items: center; }
    .schema-vm-col { max-width: 100%; min-width: unset; width: 80%; }
    .schema-fanout { display: none; }
    .rack-vm-row { grid-template-columns: 46px 110px 1fr; gap: 0 0.5rem; padding: 0.38rem 0.75rem; }
    .rack-node-header { padding: 0.65rem 0.75rem; }
    .rack-hw { display: none; }
  }
  @media (max-width: 480px) {
    .infra-hero h1 { font-size: clamp(2.7rem, 13vw, 4rem); }
