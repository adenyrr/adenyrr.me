---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteConfig, isFeatureEnabled } from '../../utils/config';
import { getCollection } from 'astro:content';
import { ArrowUpRight, Calendar, Clock, Terminal } from '@lucide/astro';

// Redirect if blog is disabled
if (!isFeatureEnabled('blog')) {
  return Astro.redirect('/');
}

const posts = (await getCollection('blog')).sort(
  (a, b) => (b.data.pubDate?.valueOf() || 0) - (a.data.pubDate?.valueOf() || 0)
);
const siteConfig = getSiteConfig();
const blog = siteConfig.blog;
---

<BaseLayout title={blog.pageTitle} description={blog.pageDescription}>
  <div class="container blog-page blog-enter">
    <header class="blog-header">
      <div>
        <p><span>~/</span>{blog.path} <i aria-hidden="true">▍</i></p>
        <h1>{blog.heading}<br /><em>{blog.headingAccent}</em></h1>
      </div>
      <aside>
        <Terminal size={16} />
        <span>{blog.introduction}</span>
      </aside>
    </header>

    {posts.length === 0 ? (
      <p class="no-articles">{blog.emptyLabel}</p>
    ) : (
      <div class="posts-list">
        {posts.map((post, index) => (
          <a href={`/blog/${post.id}`} class="card post-card">
            {post.data.heroImage && (
              <div class="post-image">
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="post-content">
              <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
              <h2>{post.data.title}</h2>
              <p class="post-description">{post.data.description}</p>
              <div class="post-meta">
                {post.data.pubDate && (
                  <span class="post-date">
                    <Calendar size={14} />
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString(siteConfig.site.locale, {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  </span>
                )}
                {post.data.readingMinutes && (
                  <span class="post-reading">
                    <Clock size={14} />
                    {post.data.readingMinutes} {blog.readingTimeSuffix}
                  </span>
                )}
              </div>
              <span class="read-more">{blog.readMoreLabel} <ArrowUpRight size={15} /></span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .blog-page {
    max-width: 1000px;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: 7rem;
  }

  .blog-header {
    display: grid;
    grid-template-columns: 1fr minmax(260px, .55fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 5rem);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .blog-header p {
    margin: 0;
    color: var(--text-muted);
    font: 650 .75rem var(--font-code);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .blog-header p span { color: var(--accent-blue); }
  .blog-header p i { color: var(--accent-amber); font-style: normal; animation: blog-cursor 1.1s steps(1) infinite; }
  @keyframes blog-cursor { 50% { opacity: 0; } }

  .blog-header h1 {
    margin: .7rem 0 0;
    font-size: clamp(3.3rem, 7.5vw, 6.5rem);
    line-height: .9;
    letter-spacing: -.07em;
  }
  .blog-header h1 em { color: var(--accent-amber); font-style: normal; }
  .blog-header aside { display: grid; grid-template-columns: auto 1fr; gap: .75rem; align-items: start; color: var(--text-secondary); font-size: .9rem; line-height: 1.65; }
  .blog-header aside :global(svg) { margin-top: .25rem; color: var(--accent-teal); }

  .no-articles {
    color: var(--muted-text);
    text-align: center;
    padding: 4rem 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    position: relative;
    display: flex;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--text);
    padding: clamp(1.25rem, 3vw, 2rem);
    overflow: hidden;
    border-radius: 15px;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .post-card::before { content: ''; position: absolute; inset: 0; opacity: 0; background: linear-gradient(120deg, rgba(var(--amber-rgb), .08), rgba(var(--blue-rgb), .06)); transition: opacity .2s ease; pointer-events: none; }
  .post-card:hover { transform: translateY(-3px); border-color: rgba(var(--blue-rgb), .4); box-shadow: var(--shadow); }
  .post-card:hover::before { opacity: 1; }

  .post-image {
    flex-shrink: 0;
    width: 200px;
    height: 140px;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-index { color: var(--accent-amber); font: 650 .65rem var(--font-code); }

  .post-content h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    line-height: 1.15;
    margin-top: .35rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }

  .post-card:hover h2 {
    color: var(--accent);
  }

  .post-description {
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    flex: 1;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .post-date,
  .post-reading {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-code);
    font-size: 0.8rem;
    color: var(--muted-text);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    align-self: flex-start;
    font-family: var(--font-code);
    font-size: 0.85rem;
    color: var(--accent);
    transition: color 0.2s ease;
  }

  .post-card:hover .read-more {
    color: var(--accent-mid);
  }

  @media (max-width: 640px) {
    .blog-header { grid-template-columns: 1fr; gap: 1.5rem; }
    .post-card {
      flex-direction: column;
    }

    .post-image {
      width: 100%;
      height: 180px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-header p i { animation: none; }
    .post-card { transition: none; }
  }
</style>
