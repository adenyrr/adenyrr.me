<script>
/**
 * Animations résiduelles en JS — GSAP et Lenis ont été retirés :
 *  - le scroll fluide est natif (html { scroll-behavior: smooth })
 *  - les reveals sont des scroll-driven animations CSS (global.css)
 *  - la barre de progression utilise animation-timeline: scroll() (BaseLayout)
 * Il ne reste que le count-up des compteurs stats (.stat-value[data-target]),
 * impossible en CSS sans attr() typé (trop récent).
 */

const prefersReducedMotion = () =>
  window.matchMedia('(prefers-reduced-motion: reduce)').matches;

let observer: IntersectionObserver | null = null;

function countUp(el: HTMLElement, target: number) {
  const small = el.querySelector('small');
  const duration = prefersReducedMotion() ? 0 : 1300;
  const start = performance.now();

  function frame(now: number) {
    const t = duration === 0 ? 1 : Math.min(1, (now - start) / duration);
    // ease-out quad
    const eased = 1 - (1 - t) * (1 - t);
    el.textContent = Math.round(eased * target).toString();
    if (small) el.appendChild(small);
    if (t < 1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

function init() {
  observer?.disconnect();
  const counters = document.querySelectorAll<HTMLElement>('.stat-value[data-target]');
  if (!counters.length) return;

  observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      const el = entry.target as HTMLElement;
      observer?.unobserve(el);
      const target = parseInt(el.dataset.target || '0', 10);
      if (target) countUp(el, target);
    }
  }, { rootMargin: '0px 0px -10% 0px' });

  counters.forEach((el) => observer?.observe(el));
}

document.addEventListener('astro:page-load', init);
</script>
