---
import { getSiteConfig } from '../utils/config';
import { Rss, GitBranch, Heart } from '@lucide/astro';

const config = getSiteConfig();
const year = new Date().getFullYear();
const footer = config.footer || {};
const author = footer.author || config.site.author;
const authorUrl = footer.authorUrl || '/';
---

<footer class="powerline">
  <div class="pl-bar">
    <!-- Segment 1: user@host -->
    <a class="pl-seg pl-seg-1" href={authorUrl} target="_blank" rel="noopener noreferrer">
      <span class="pl-glyph">»</span>
      <span class="pl-text">{author}@adenyrr.me</span>
    </a>

    <!-- Segment 2: branch / status -->
    <span class="pl-seg pl-seg-2">
      <GitBranch size={12} />
      <span class="pl-text">main</span>
      <span class="pl-dot" aria-hidden="true"></span>
    </span>

    <!-- Segment 3: powered by (RSS + tech) -->
    <span class="pl-seg pl-seg-3">
      {footer.rss && (
        <a href="/rss.xml" aria-label="RSS" title="RSS" class="pl-link">
          <Rss size={12} />
        </a>
      )}
      <span class="pl-text">
        {(footer.poweredBy || []).map((item: any, i: number) => (
          <>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="pl-link">{item.label}</a>
            {i < (footer.poweredBy?.length || 0) - 1 && <span class="pl-sep">·</span>}
          </>
        ))}
      </span>
    </span>

    <!-- Filler spacer -->
    <span class="pl-spacer" aria-hidden="true"></span>

    <!-- Segment 4: license -->
    <span class="pl-seg pl-seg-4">
      <span class="pl-text">{footer.copyright || `© ${year}`}</span>
    </span>

    <!-- Segment 5: made with -->
    <span class="pl-seg pl-seg-5">
      <Heart size={11} class="pl-heart" />
      <span class="pl-text">© {year}</span>
    </span>
  </div>
</footer>

<style>
  /* ── Powerline tmux-style status bar ────────────────── */
  .powerline {
    position: relative;
    margin-top: 4rem;
    padding: 0;
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .pl-bar {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    width: 100%;
    min-height: 28px;
    background: var(--surface-raised);
    border-top: 1px solid color-mix(in srgb, var(--accent) 18%, var(--card-border));
    overflow: hidden;
  }

  .pl-seg {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.6rem 0 0.85rem;
    line-height: 28px;
    height: 28px;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
    transition: filter 0.2s ease;
    position: relative;
  }

  /* Powerline arrow (right-pointing) using clip-path */
  .pl-seg::after {
    content: '';
    display: inline-block;
    width: 12px;
    height: 28px;
    margin-right: -12px;
    margin-left: 0.55rem;
    background: inherit;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    z-index: 1;
  }
  /* Reverse arrow before for right-aligned segments */

  .pl-seg-1 {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    padding-left: 1rem;
  }
  .pl-seg-1:hover { filter: brightness(1.08); }

  .pl-seg-2 {
    background: color-mix(in srgb, var(--accent) 28%, var(--surface));
    color: var(--text);
  }

  .pl-seg-3 {
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text-secondary);
  }

  .pl-seg-4 {
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text-secondary);
  }
  .pl-seg-4::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 28px;
    margin-left: -0.85rem;
    margin-right: 0.55rem;
    background: inherit;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }
  .pl-seg-4::after { display: none; }

  .pl-seg-5 {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    padding-right: 1rem;
  }
  .pl-seg-5::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 28px;
    margin-left: -0.85rem;
    margin-right: 0.55rem;
    background: inherit;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }
  .pl-seg-5::after { display: none; }

  .pl-spacer {
    flex: 1;
    background: var(--surface-raised);
    min-height: 28px;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 18%, transparent);
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 18%, transparent);
    border-image-slice: 0;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 6px,
      color-mix(in srgb, var(--accent) 8%, transparent) 6px,
      color-mix(in srgb, var(--accent) 8%, transparent) 7px
    );
  }

  .pl-glyph {
    color: var(--bg);
    opacity: 0.9;
    margin-right: 0.15rem;
  }

  .pl-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .pl-link:hover { opacity: 0.7; }

  .pl-sep {
    margin: 0 0.35rem;
    color: var(--muted-text);
    opacity: 0.6;
  }

  .pl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sem-ok);
    box-shadow: 0 0 6px var(--sem-ok);
    animation: pl-pulse 2.2s ease-in-out infinite;
  }
  @keyframes pl-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50%      { opacity: 1; transform: scale(1.1); }
  }

  .pl-heart {
    color: #ff6b9b;
    fill: currentColor;
    animation: pl-heartbeat 1.6s ease-in-out infinite;
  }
  @keyframes pl-heartbeat {
    0%, 100% { transform: scale(1); }
    20%      { transform: scale(1.18); }
    40%      { transform: scale(1); }
    60%      { transform: scale(1.1); }
    80%      { transform: scale(1); }
  }

  /* Mobile : segments stack but keep powerline feel via dashed connectors */
  @media (max-width: 720px) {
    .pl-bar { flex-direction: column; min-height: auto; }
    .pl-seg { width: 100%; padding-left: 0.85rem !important; padding-right: 0.85rem !important; height: 26px; line-height: 26px; }
    .pl-seg::before,
    .pl-seg::after { display: none !important; }
    .pl-spacer { display: none; }
    .pl-seg-1 { font-size: 0.7rem; }
  }
</style>
