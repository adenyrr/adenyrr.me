---
import { getSiteConfig } from '../utils/config';
import { Rss, GitBranch, Heart } from '@lucide/astro';

const config = getSiteConfig();
const year = new Date().getFullYear();
const footer = config.footer || {};
const author = footer.author || config.site.author;
const authorUrl = footer.authorUrl || '/';
---

<footer id="site-footer" class="powerline">
  <div class="pl-bar">
    <!-- Segment 1: user@host -->
    <a class="pl-seg pl-seg-1" href={authorUrl} target="_blank" rel="noopener noreferrer">
      <span class="pl-glyph" aria-hidden="true">›</span>
      <span class="pl-text">{author}@adenyrr.me</span>
      {/* chemin + $ : la capsule se lit comme une vraie invite de shell */}
      <span class="pl-path" aria-hidden="true">:~$</span>
    </a>

    <!-- Segment 2: branch / status -->
    <span class="pl-seg pl-seg-2">
      <GitBranch size={12} aria-hidden="true" />
      <span class="pl-text">main</span>
      <!-- La pastille ne porte pas l'info seule : un libellé la double (§1.3) -->
      <span class="pl-dot" aria-hidden="true"></span>
      <span class="sr-only">— branche à jour</span>
    </span>

    <!-- Segment 3: RSS feed (mis en avant) -->
    {footer.rss && (
      <a class="pl-seg pl-seg-rss" href="/rss.xml" aria-label="S'abonner au flux RSS" title="Flux RSS">
        <Rss size={14} class="pl-rss-icon" />
        <span class="pl-text">rss feed</span>
        <span class="pl-rss-pulse" aria-hidden="true"></span>
      </a>
    )}

    <!-- Segment 4: powered by tech — crochets façon man-page, comme .tag -->
    <span class="pl-seg pl-seg-3">
      <span class="pl-text">
        {(footer.poweredBy || []).map((item: any) => (
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="pl-link">{item.label}</a>
        ))}
      </span>
    </span>

    <!-- Filler spacer -->
    <span class="pl-spacer" aria-hidden="true"></span>

    <!-- Segment 5: license — préfixe « # » : un commentaire shell -->
    <span class="pl-seg pl-seg-4">
      <span class="pl-hash" aria-hidden="true">#</span>
      <span class="pl-text">{footer.copyright || `© ${year}`}</span>
    </span>

    <!-- Segment 6: made with -->
    <span class="pl-seg pl-seg-5">
      <Heart size={11} class="pl-heart" />
      <span class="pl-text">© {year}</span>
    </span>

    <!-- Curseur en fin d'invite — même caret que les titres ~/section -->
    <span class="pl-caret" aria-hidden="true">▍</span>
  </div>
</footer>

<style>
  /* ── Powerline tmux-style status bar ────────────────── */
  .powerline {
    position: relative;
    margin-top: 4rem;
    padding: 0;
    font-family: var(--font-code);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  /* Barre en verre : les segments powerline deviennent des capsules de
     verre dépoli (§1.7) — le motif « segment » reste, les angles vifs et
     les chevrons en clip-path disparaissent. */
  .pl-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    width: 100%;
    padding: 0.7rem 1.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border-top: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glint);
  }

  /* Capsule de base — recette §3.3 */
  .pl-seg {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--glass-bg-strong);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    box-shadow: inset 0 1px 0 var(--glint);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease,
                color 0.2s ease, transform 0.2s ease;
  }

  a.pl-seg:hover { transform: translateY(-1px); }

  a.pl-seg:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* Variantes teintées : fond/bordure en couleur « vive » constante,
     texte en couleur « ink » qui garantit le contraste (§1.2). */
  .pl-seg-1 {
    color: var(--accent-amber);
    background: rgba(var(--amber-rgb), .16);
    border-color: rgba(var(--amber-rgb), .40);
    font-weight: 600;
  }
  .pl-seg-1:hover {
    background: rgba(var(--amber-rgb), .24);
    border-color: rgba(var(--amber-rgb), .55);
  }

  .pl-seg-2 {
    color: var(--accent-teal);
    background: rgba(var(--teal-rgb), .14);
    border-color: rgba(var(--teal-rgb), .35);
  }

  /* RSS — teinte corail proche de l'orange canonique du flux, mais en
     couche ink/vif : le blanc sur #f26522 ne tenait que ~3.4:1. */
  .pl-seg-rss {
    color: var(--accent-coral);
    background: rgba(var(--coral-rgb), .16);
    border-color: rgba(var(--coral-rgb), .42);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }
  .pl-seg-rss:hover {
    background: rgba(var(--coral-rgb), .26);
    border-color: rgba(var(--coral-rgb), .60);
  }
  .pl-rss-icon { flex-shrink: 0; }
  .pl-rss-pulse {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pl-rss-pulse 1.8s ease-in-out infinite;
  }
  @keyframes pl-rss-pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1.1); }
  }

  .pl-seg-3,
  .pl-seg-4 {
    color: var(--text-secondary);
  }

  .pl-seg-5 {
    color: var(--text-secondary);
  }

  .pl-spacer {
    flex: 1;
    min-width: 0;
  }

  /* Chevron d'invite « › » — même glyphe que .prompt-arrow de la bannière */
  .pl-glyph {
    opacity: 0.85;
    margin-right: 0.05rem;
    font-weight: 700;
  }

  /* Chemin « :~$ » — collé au nom d'hôte : le gap de 0.45rem du flex est
     annulé, sinon l'invite s'écrit « host :~$ » au lieu de « host:~$ ». */
  .pl-path {
    opacity: 0.65;
    margin-left: -0.45rem;
    letter-spacing: 0;
  }

  /* « # » de commentaire shell devant la licence */
  .pl-hash {
    color: var(--text-muted);
    opacity: 0.8;
    margin-right: -0.15rem;
  }

  /* Liens « powered by » en crochets façon man-page, comme .tag */
  .pl-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .pl-link + .pl-link { margin-left: 0.5rem; }
  .pl-link::before,
  .pl-link::after {
    color: var(--text-muted);
    opacity: 0.55;
    font-weight: 400;
  }
  .pl-link::before { content: '[ '; }
  .pl-link::after  { content: ' ]'; }
  .pl-link:hover { color: var(--accent-amber); }

  /* Curseur clignotant de fin d'invite — cadence identique à .term-caret */
  .pl-caret {
    color: var(--accent-amber);
    line-height: 1;
    margin-left: 0.15rem;
    animation: pl-blink 1.05s steps(1, end) infinite;
  }
  @keyframes pl-blink {
    0%, 50%   { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  .pl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sem-ok);
    box-shadow: 0 0 6px var(--sem-ok);
    animation: pl-pulse 2.2s ease-in-out infinite;
  }
  @keyframes pl-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50%      { opacity: 1; transform: scale(1.1); }
  }

  .pl-heart {
    /* Le segment n'a plus de fond plein : l'ink corail suffit et tient
       le contraste sur le verre dans les deux thèmes. */
    color: var(--accent-coral);
    fill: currentColor;
    animation: pl-heartbeat 1.6s ease-in-out infinite;
  }
  @keyframes pl-heartbeat {
    0%, 100% { transform: scale(1); }
    20%      { transform: scale(1.18); }
    40%      { transform: scale(1); }
    60%      { transform: scale(1.1); }
    80%      { transform: scale(1); }
  }

  /* Curseur clignotant → statique, halos → fixes (§4) */
  @media (prefers-reduced-motion: reduce) {
    .pl-dot,
    .pl-rss-pulse,
    .pl-heart,
    .pl-caret { animation: none; }
  }

  /* Mobile : les capsules s'enroulent naturellement — plus besoin de
     casser une géométrie de chevrons qui n'existe plus. */
  @media (max-width: 720px) {
    .powerline { font-size: 0.8rem; }
    .pl-bar {
      padding: 0.75rem 1rem;
      justify-content: center;
      gap: 0.35rem;
    }
    .pl-spacer { display: none; }
  }
</style>

