---
import { getSiteConfig } from '../utils/config';
import { Rss, GitBranch, Heart } from '@lucide/astro';

const config = getSiteConfig();
const year = new Date().getFullYear();
const footer = config.footer || {};
const author = footer.author || config.site.author;
const authorUrl = footer.authorUrl || '/';
---

<footer id="site-footer" class="powerline">
  <div class="pl-bar">
    <!-- Segment 1: user@host -->
    <a class="pl-seg pl-seg-1" href={authorUrl} target="_blank" rel="noopener noreferrer">
      <span class="pl-glyph">»</span>
      <span class="pl-text">{author}@adenyrr.me</span>
    </a>

    <!-- Segment 2: branch / status -->
    <span class="pl-seg pl-seg-2">
      <GitBranch size={12} />
      <span class="pl-text">main</span>
      <span class="pl-dot" aria-hidden="true"></span>
    </span>

    <!-- Segment 3: RSS feed (mis en avant) -->
    {footer.rss && (
      <a class="pl-seg pl-seg-rss" href="/rss.xml" aria-label="S'abonner au flux RSS" title="Flux RSS">
        <Rss size={14} class="pl-rss-icon" />
        <span class="pl-text">rss feed</span>
        <span class="pl-rss-pulse" aria-hidden="true"></span>
      </a>
    )}

    <!-- Segment 4: powered by tech -->
    <span class="pl-seg pl-seg-3">
      <span class="pl-text">
        {(footer.poweredBy || []).map((item: any, i: number) => (
          <>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="pl-link">{item.label}</a>
            {i < (footer.poweredBy?.length || 0) - 1 && <span class="pl-sep">·</span>}
          </>
        ))}
      </span>
    </span>

    <!-- Filler spacer -->
    <span class="pl-spacer" aria-hidden="true"></span>

    <!-- Segment 4: license -->
    <span class="pl-seg pl-seg-4">
      <span class="pl-text">{footer.copyright || `© ${year}`}</span>
    </span>

    <!-- Segment 5: made with -->
    <span class="pl-seg pl-seg-5">
      <Heart size={11} class="pl-heart" />
      <span class="pl-text">© {year}</span>
    </span>
  </div>
</footer>

<style>
  /* ── Powerline tmux-style status bar ────────────────── */
  .powerline {
    position: relative;
    margin-top: 4rem;
    padding: 0;
    font-family: var(--font-code);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .pl-bar {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    width: 100%;
    min-height: 42px;
    background: var(--surface-raised);
    border-top: 1px solid color-mix(in srgb, var(--accent) 18%, var(--card-border));
    overflow: hidden;
  }

  .pl-seg {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0 0.9rem 0 1.1rem;
    line-height: 42px;
    height: 42px;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
    transition: filter 0.2s ease;
    position: relative;
  }

  /* Powerline arrow (right-pointing) using clip-path */
  .pl-seg::after {
    content: '';
    display: inline-block;
    width: 18px;
    height: 42px;
    margin-right: -18px;
    margin-left: 0.75rem;
    background: inherit;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    z-index: 1;
  }
  /* Reverse arrow before for right-aligned segments */

  .pl-seg-1 {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    padding-left: 1.25rem;
  }
  .pl-seg-1:hover { filter: brightness(1.08); }

  .pl-seg-2 {
    background: color-mix(in srgb, var(--accent) 28%, var(--surface));
    color: var(--text);
  }

  /* RSS — segment d'appel orange vif et icône proéminente */
  .pl-seg-rss {
    background: #f26522; /* RSS canonical orange */
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
  .pl-seg-rss:hover { filter: brightness(1.12); }
  .pl-rss-icon {
    flex-shrink: 0;
  }
  .pl-rss-pulse {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px rgba(255,255,255,0.8);
    animation: pl-rss-pulse 1.8s ease-in-out infinite;
  }
  @keyframes pl-rss-pulse {
    0%, 100% { opacity: 0.45; transform: scale(0.85); }
    50%      { opacity: 1; transform: scale(1.1); }
  }

  .pl-seg-3 {
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text-secondary);
  }

  .pl-seg-4 {
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text-secondary);
  }
  .pl-seg-4::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 42px;
    margin-left: -1.1rem;
    margin-right: 0.75rem;
    background: inherit;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }
  .pl-seg-4::after { display: none; }

  .pl-seg-5 {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    padding-right: 1.25rem;
  }
  .pl-seg-5::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 42px;
    margin-left: -1.1rem;
    margin-right: 0.75rem;
    background: inherit;
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }
  .pl-seg-5::after { display: none; }

  .pl-spacer {
    flex: 1;
    background: var(--surface-raised);
    min-height: 42px;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 7px,
      color-mix(in srgb, var(--accent) 10%, transparent) 7px,
      color-mix(in srgb, var(--accent) 10%, transparent) 8px
    );
  }

  .pl-glyph {
    color: var(--bg);
    opacity: 0.9;
    margin-right: 0.15rem;
  }

  .pl-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .pl-link:hover { opacity: 0.7; }

  .pl-sep {
    margin: 0 0.35rem;
    color: var(--muted-text);
    opacity: 0.6;
  }

  .pl-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sem-ok);
    box-shadow: 0 0 6px var(--sem-ok);
    animation: pl-pulse 2.2s ease-in-out infinite;
  }
  @keyframes pl-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.9); }
    50%      { opacity: 1; transform: scale(1.1); }
  }

  .pl-heart {
    /* rose --secplus du thème ; inversé car le segment porte --accent en fond */
    color: light-dark(#f27ba6, #a81a52);
    fill: currentColor;
    animation: pl-heartbeat 1.6s ease-in-out infinite;
  }
  @keyframes pl-heartbeat {
    0%, 100% { transform: scale(1); }
    20%      { transform: scale(1.18); }
    40%      { transform: scale(1); }
    60%      { transform: scale(1.1); }
    80%      { transform: scale(1); }
  }

  /* Mobile : segments stack but keep powerline feel via dashed connectors */
  @media (max-width: 720px) {
    .powerline { font-size: 0.8rem; }
    .pl-bar { flex-direction: column; min-height: auto; }
    .pl-seg { width: 100%; padding-left: 1.1rem !important; padding-right: 1.1rem !important; height: 38px; line-height: 38px; justify-content: flex-start; }
    .pl-seg::before,
    .pl-seg::after { display: none !important; }
    .pl-spacer { display: none; }
  }
</style>
