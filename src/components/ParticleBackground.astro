---
/**
 * Fond ambiant — remplace l'ancien canvas de particules (rAF permanent).
 * 100 % CSS, zéro JavaScript : grille de points masquée + deux nappes
 * "aurora" en dégradés radiaux qui dérivent lentement.
 * Respecte le flag `appearance.ambientBackground` du site.yaml.
 */
import { getSiteConfig } from '../utils/config';
const config = getSiteConfig();
const enabled = config.appearance.ambientBackground;
---

{enabled && (
  <div id="ambient-bg" aria-hidden="true">
    <div class="ambient-aurora ambient-aurora-1"></div>
    <div class="ambient-aurora ambient-aurora-2"></div>
  </div>
)}

<style>
  #ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* Grille de points façon blueprint, estompée vers le bas */
    background-image: radial-gradient(var(--ambient-dot) 1px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, black 0%, rgba(0, 0, 0, 0.35) 45%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, black 0%, rgba(0, 0, 0, 0.35) 45%, transparent 85%);
  }

  .ambient-aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    will-change: transform;
  }

  /* Nappes en dérive : elles s'ajoutent aux trois halos §3.2 posés sur
     <body> (qui sont, eux, statiques et obligatoires). D'où des tokens
     dédiés à faible alpha — sinon la superposition sature la page. */
  .ambient-aurora-1 {
    width: 55vw;
    height: 45vh;
    top: -18vh;
    left: -12vw;
    background: radial-gradient(ellipse at center, var(--blob-drift-blue) 0%, transparent 70%);
    animation: aurora-drift-1 38s ease-in-out infinite alternate;
  }

  .ambient-aurora-2 {
    width: 45vw;
    height: 40vh;
    bottom: -15vh;
    right: -10vw;
    background: radial-gradient(ellipse at center, var(--blob-drift-amber) 0%, transparent 70%);
    animation: aurora-drift-2 46s ease-in-out infinite alternate;
  }

  @keyframes aurora-drift-1 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(14vw, 10vh) scale(1.18); }
  }

  @keyframes aurora-drift-2 {
    from { transform: translate(0, 0) scale(1.1); }
    to   { transform: translate(-12vw, -8vh) scale(0.95); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-aurora { animation: none; }
  }

  /* Sur mobile : blur coûteux réduit, pas d'animation continue */
  @media (max-width: 768px) {
    .ambient-aurora { filter: blur(40px); animation: none; }
  }
</style>
