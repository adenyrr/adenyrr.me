---
import { getSiteConfig } from '../utils/config';
import ThemeToggle from './ThemeToggle.astro';
import ReadingModeToggle from './ReadingModeToggle.astro';
import { ExternalLink, Github, Menu, Terminal, X } from '@lucide/astro';

const config = getSiteConfig();
const currentPath = Astro.url.pathname;
const navItems = (config.header?.navigation || []).filter(
  (item: any) => item.enabled && (!item.feature || config.features[item.feature]),
);
const socialLinks = (config.header?.socialLinks || []).filter((link: any) => link.enabled);
const githubLink = socialLinks.find((link: any) => link.label.toLowerCase() === 'github');

function active(item: any) {
  return !item.external && (currentPath === item.route || (item.route !== '/' && currentPath.startsWith(item.route)));
}
---

{config.header.show && <header id="site-header">
  <a class="skip-link" href="#main">Aller au contenu principal</a>
  <div class="header-shell">
    <a class="brand" href="/" aria-label={`${config.header.brandName} — accueil`}>
      <span class="brand-glyph"><Terminal size={15} /></span>
      <span>{config.header.brandName}</span><span class="brand-host">{config.header.brandHost}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {navItems.map((item: any) => {
        const href = item.external ? item.url : item.route;
        const isActive = active(item);
        return (
          <a href={href} class:list={['nav-item', { active: isActive }]} aria-current={isActive ? 'page' : undefined}
            target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
            <span aria-hidden="true">~/</span>{item.label}{item.external && <ExternalLink size={10} />}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      {githubLink && <a class="github-link" href={githubLink.url} target="_blank" rel="noopener noreferrer" aria-label={githubLink.label}><Github size={17} /></a>}
      <ReadingModeToggle />
      <ThemeToggle />
      <details class="mobile-menu">
        <summary aria-label="Ouvrir le menu"><Menu class="menu-open" size={19} /><X class="menu-close" size={19} /></summary>
        <div class="mobile-panel">
          <p><span aria-hidden="true">$</span> cd ~/navigation</p>
          <nav aria-label="Navigation mobile">
            {navItems.map((item: any, index: number) => {
              const href = item.external ? item.url : item.route;
              const isActive = active(item);
              return (
                <a href={href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}
                  target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
                  <small>0{index + 1}</small><span>/{item.label}</span>{item.external ? <ExternalLink size={14} /> : <span aria-hidden="true">↗</span>}
                </a>
              );
            })}
          </nav>
          <div class="mobile-socials">
            {socialLinks.map((link: any) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>}

<style>
  #site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: .7rem 1rem;
    pointer-events: none;
  }

  .header-shell {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1180px, 100%);
    min-height: 52px;
    margin: 0 auto;
    padding: .35rem .45rem .35rem .7rem;
    background: color-mix(in srgb, var(--glass-bg-strong) 90%, transparent);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow: 0 12px 40px -22px rgba(0,0,0,.7), inset 0 1px var(--glint);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    pointer-events: auto;
  }

  .skip-link {
    position: fixed;
    top: -5rem;
    left: 1rem;
    z-index: 200;
    padding: .7rem 1rem;
    color: var(--bg-0);
    background: var(--accent-blue);
    border-radius: 8px;
    font: 700 .78rem var(--font-code);
    transition: top .15s ease;
    pointer-events: auto;
  }
  .skip-link:focus { top: 1rem; }

  .brand { display: inline-flex; align-items: center; gap: .3rem; justify-self: start; color: var(--text-primary); font: 700 .8rem var(--font-code); text-decoration: none; }
  .brand-glyph { display: grid; place-items: center; width: 29px; height: 29px; margin-right: .18rem; color: var(--bg-0); background: var(--accent-amber); border-radius: 7px; }
  .brand-host { color: var(--text-muted); font-weight: 450; }
  .brand:hover .brand-host { color: var(--accent-blue); }

  .desktop-nav { display: flex; gap: .15rem; justify-self: center; }
  .nav-item { position: relative; display: inline-flex; align-items: center; gap: .12rem; min-height: 38px; padding: .5rem .72rem; color: var(--text-muted); border: 1px solid transparent; border-radius: 8px; font: 550 .72rem var(--font-code); text-decoration: none; }
  .nav-item > span { color: var(--text-muted); opacity: .6; }
  .nav-item:hover { color: var(--text-primary); background: rgba(var(--blue-rgb), .07); }
  .nav-item.active { color: var(--text-primary); background: var(--glass-bg-strong); border-color: var(--glass-border); box-shadow: inset 0 -2px var(--accent-amber); }
  .nav-item.active > span { color: var(--accent-amber); opacity: 1; }

  .header-actions { display: flex; align-items: center; justify-self: end; gap: .1rem; }
  .github-link { display: grid; place-items: center; width: 40px; height: 40px; color: var(--text-muted); border-radius: 8px; }
  .github-link:hover { color: var(--text-primary); background: var(--glass-bg); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { display: grid; place-items: center; width: 42px; height: 42px; color: var(--text-primary); border-radius: 8px; cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary:hover { background: var(--glass-bg); }
  .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: block; }
  .mobile-panel { position: fixed; top: 4.65rem; left: 1rem; right: 1rem; padding: 1.15rem; color: var(--text-primary); background: var(--bg-1); border: 1px solid var(--glass-border); border-radius: 14px; box-shadow: var(--shadow); }
  .mobile-panel > p { margin: 0 0 .8rem; color: var(--text-muted); font: .7rem var(--font-code); }
  .mobile-panel > p span { color: var(--accent-teal); }
  .mobile-panel nav { display: grid; gap: .3rem; }
  .mobile-panel nav a { display: grid; grid-template-columns: 38px 1fr auto; align-items: center; min-height: 50px; padding: .5rem .7rem; color: var(--text-secondary); border: 1px solid transparent; border-radius: 9px; font: .82rem var(--font-code); text-decoration: none; }
  .mobile-panel nav a small { color: var(--text-muted); font-size: .6rem; }
  .mobile-panel nav a.active { color: var(--text-primary); border-color: rgba(var(--amber-rgb), .35); background: rgba(var(--amber-rgb), .08); }
  .mobile-panel nav a.active small { color: var(--accent-amber); }
  .mobile-socials { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--glass-border); }
  .mobile-socials a { color: var(--text-muted); font: .66rem var(--font-code); text-underline-offset: 3px; }

  @media (max-width: 820px) {
    #site-header { padding: .5rem .6rem; }
    .header-shell { grid-template-columns: 1fr auto; }
    .desktop-nav, .github-link { display: none; }
    .mobile-menu { display: block; }
    .brand-host { display: none; }
  }
  @media (max-width: 380px) {
    .header-shell { padding-left: .45rem; }
    .brand > span:not(.brand-glyph) { display: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header-shell { background: var(--bg-1); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
</style>

<script>
  function initMobileMenu() {
    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    if (!menu) return;
    menu.querySelectorAll('a').forEach((link) => { link.addEventListener('click', () => menu.removeAttribute('open'), { once: true }); });
  }
  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
