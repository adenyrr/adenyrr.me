---
import { getSiteConfig } from '../utils/config';
import ThemeToggle from './ThemeToggle.astro';
import MobileNav from './MobileNav.tsx';
import {
  Github, Gitlab, Linkedin, MessageCircle, Mail, Rss,
  User, Server, FileText, Library, ExternalLink
} from '@lucide/astro';

const config = getSiteConfig();
const currentPath = Astro.url.pathname;

// Filter enabled navigation items based on features
const navItems = (config.header?.navigation || []).filter(
  (item: any) => item.enabled && config.features?.[item.label] !== false
);

// Filter enabled social links
const socialLinks = (config.header?.socialLinks || []).filter(
  (link: any) => link.enabled
);

// Map icon names to components
const iconMap: Record<string, any> = {
  Github, Gitlab, Linkedin, MessageCircle, Mail, Rss,
  User, Server, FileText, Library
};
---

<header id="site-header">
  <div class="header-inner">
    <a class="skip-link" href="#main">Aller au contenu</a>

    <a href="/" class="header-brand">
      {config.header?.brandName || config.site.title}<span class="brand-cursor">_</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item: any) => {
        const href = item.external ? item.url : item.route;
        const isActive = !item.external && (
          currentPath === item.route ||
          (item.route !== '/' && currentPath.startsWith(item.route))
        );
        return (
          <a
            href={href}
            class:list={['nav-link', { active: isActive }]}
            aria-current={isActive ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            /{item.label}{item.external && <ExternalLink size={10} class="nav-link-external-icon" />}
          </a>
        );
      })}
    </nav>

    <div class="nav-right">
      <div class="social-links">
        {socialLinks.map((link: any) => {
          const Icon = iconMap[link.icon];
          return Icon ? (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              <Icon size={18} />
            </a>
          ) : null;
        })}
      </div>
      <ThemeToggle />
      <MobileNav
          client:load
          navItems={navItems.map((item: any) => ({ label: item.label, route: item.external ? item.url : item.route, external: item.external }))}
          socialLinks={socialLinks.map((link: any) => ({ label: link.label, url: link.url, icon: link.icon }))}
          currentPath={currentPath}
        />
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    /* Barre active → verre renforcé (§2.1), recette §3.1 */
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glint);
    transition: var(--transition-colors), box-shadow 0.3s ease;
  }

  @media (max-width: 768px) {
    header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--surface);
    }
  }

  /* Élévation au scroll — scroll-driven animation native (zéro JS) :
     l'ombre apparaît progressivement sur les 120 premiers pixels. */
  @supports (animation-timeline: scroll()) {
    header {
      animation: header-elevate linear both;
      animation-timeline: scroll(root);
      animation-range: 0 120px;
    }
  }

  @keyframes header-elevate {
    from { box-shadow: 0 4px 24px transparent; }
    to {
      /* Ombre bleu-ardoise en clair (jamais du noir pur sous le verre) */
      box-shadow: 0 4px 24px light-dark(rgba(20,30,45,.16), rgba(0,0,0,.45)),
                  0 1px 0 var(--glass-border);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 50px;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 200;
    background: var(--bg-1);
    color: var(--accent-amber);
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(var(--amber-rgb), .45);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .skip-link:focus {
    left: 1rem;
    top: 0.5rem;
  }

  .header-brand {
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
    font-family: var(--font-code);
    letter-spacing: -0.5px;
    color: var(--text);
    display: inline-flex;
    align-items: baseline;
  }

  .header-brand:hover {
    color: var(--accent);
  }

  .brand-cursor {
    color: var(--accent);
    animation: blink-cursor 1s step-end infinite;
    font-weight: 400;
    margin-left: 1px;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 2rem;
    flex: 1;
  }

  /* Les entrées de nav reprennent le motif « segment de verre » : capsule
     complète plutôt que bloc à angles vifs (§1.7 / §3.3). */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease,
                border-color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--accent-amber);
    background: rgba(var(--amber-rgb), .10);
    border-color: rgba(var(--amber-rgb), .22);
  }

  /* Actif = graisse + fond renforcé + soulignement vif. Jamais la couleur
     seule (§3.6) : lisible en niveaux de gris comme en daltonisme. */
  .nav-link.active {
    color: var(--accent-amber);
    font-weight: 700;
    background: rgba(var(--amber-rgb), .16);
    border-color: rgba(var(--amber-rgb), .40);
    box-shadow: inset 0 1px 0 var(--glint);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.18rem;
    height: 1.5px;
    border-radius: 1px;
    background: rgba(var(--amber-rgb), .9);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--text-muted);
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color 0.2s ease, background-color 0.2s ease,
                border-color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--accent-amber);
    background: rgba(var(--amber-rgb), .12);
    border-color: rgba(var(--amber-rgb), .25);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .social-links { display: none; }
  }

  .nav-link-external-icon {
    display: inline-block;
    vertical-align: middle;
    margin-left: 3px;
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* Hide mobile nav trigger on desktop — more reliable than Tailwind md:hidden
     inside a React island (Tailwind v4 scan may miss it). */
  :global(.mobile-nav-trigger) {
    display: none;
  }
  @media (max-width: 768px) {
    :global(.mobile-nav-trigger) {
      display: flex;
    }
  }
</style>

