---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '@adenyrr/astro-sovereign-tty/Header.astro';
import Footer from '@adenyrr/astro-sovereign-tty/Footer.astro';
import AmbientBackground from '@adenyrr/astro-sovereign-tty/AmbientBackground.astro';
import Animations from '@adenyrr/astro-sovereign-tty/Animations.astro';
import { getSiteConfig } from '../utils/config';
import '@adenyrr/astro-sovereign-tty/styles.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article = false } = Astro.props;
const config = getSiteConfig();
---

<!doctype html>
<html lang={config.site.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true">
      <div class="scroll-progress-bar"></div>
    </div>
    <AmbientBackground enabled={config.appearance.ambientBackground} transition:persist="particle-bg" />
    <Header config={config} currentPath={Astro.url.pathname} />
    <main id="main" class="page-content" style="position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer config={config} />
    <Animations />

    <script>
      // Listen during capture so Astro's ClientRouter cannot turn this same-page
      // anchor into a navigation before we start the scroll.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const link = event.target.closest<HTMLAnchorElement>('a.back-top');
        if (!link) return;

        event.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      }, { capture: true });
    </script>

    <style>
      /* Barre de progression de lecture — scroll-driven animation native,
         zéro JavaScript. Masquée si le navigateur ne supporte pas
         animation-timeline (dégradation propre). */
      #scroll-progress {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 2px;
        z-index: 200;
        pointer-events: none;
        background: color-mix(in srgb, var(--accent) 4%, transparent);
      }

      .scroll-progress-bar {
        height: 100%;
        background: linear-gradient(90deg,
          color-mix(in srgb, var(--accent) 95%, transparent),
          var(--link-color));
        box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
        transform-origin: 0 50%;
        transform: scaleX(0);
      }

      @supports (animation-timeline: scroll()) {
        #scroll-progress { display: block; }
        .scroll-progress-bar {
          animation: scroll-progress-grow linear both;
          animation-timeline: scroll(root);
        }
      }

      @keyframes scroll-progress-grow {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
    </style>
  </body>
</html>
