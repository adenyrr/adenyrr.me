---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import Animations from '../components/Animations.astro';
import { getSiteConfig } from '../utils/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article = false } = Astro.props;
const config = getSiteConfig();
---

<!doctype html>
<html lang={config.site.locale}>
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true">
      <div class="scroll-progress-bar"></div>
    </div>
    <ParticleBackground transition:persist="particle-bg" />
    <Header />
    <main id="main" class="page-content" style="position: relative; z-index: 1;">
      <slot />
    </main>
    <Footer />
    <Animations />

    <style>
      /* Barre de progression de lecture — scroll-driven animation native,
         zéro JavaScript. Masquée si le navigateur ne supporte pas
         animation-timeline (dégradation propre). */
      #scroll-progress {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 2px;
        z-index: 200;
        pointer-events: none;
        background: color-mix(in srgb, var(--accent) 4%, transparent);
      }

      .scroll-progress-bar {
        height: 100%;
        background: linear-gradient(90deg,
          color-mix(in srgb, var(--accent) 95%, transparent),
          var(--link-color));
        box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
        transform-origin: 0 50%;
        transform: scaleX(0);
      }

      @supports (animation-timeline: scroll()) {
        #scroll-progress { display: block; }
        .scroll-progress-bar {
          animation: scroll-progress-grow linear both;
          animation-timeline: scroll(root);
        }
      }

      @keyframes scroll-progress-grow {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
    </style>
  </body>
</html>
